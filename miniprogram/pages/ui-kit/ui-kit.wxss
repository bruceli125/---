/* ============================================================================
 * LIGHTCORE PRISM · 设计系统展示页
 * 本页样式全部基于 app.wxss 的令牌，不引入新颜色（虹彩除外）
 * ========================================================================== */

.ui-page {
  min-height: 100vh;
  background: var(--snow);
  padding-bottom: 60rpx;
}

/* ---------------- 页头 ---------------- */
.ui-hero {
  position: relative;
  padding: 46rpx 36rpx 40rpx;
  background: linear-gradient(180deg, #ffffff, #fafafc);
  border-radius: 0 0 40rpx 40rpx;
  overflow: hidden;
}

.ui-hero__wash {
  position: absolute;
  left: -30%;
  right: -30%;
  top: -280rpx;
  height: 540rpx;
  background: var(--grad-prism-soft);
  filter: blur(48rpx);
  pointer-events: none;
}

.ui-hero__ring {
  position: absolute;
  right: -30rpx;
  top: 40rpx;
  opacity: 0.95;
  pointer-events: none;
}

.ui-hero__inner {
  position: relative;
  z-index: 1;
  padding-right: 200rpx;
}

.ui-eyebrow {
  font-size: 19rpx;
  font-weight: 700;
  letter-spacing: 0.32em;
  color: var(--ink-4);
}

.ui-title {
  margin-top: 14rpx;
  font-size: 46rpx;
  font-weight: 700;
  letter-spacing: -0.035em;
  line-height: 1.1;
  color: var(--ink);
}

.ui-hero__bar {
  width: 108rpx;
  margin: 18rpx 0 14rpx;
}

.ui-sub {
  font-size: 23rpx;
  color: var(--ink-4);
}

.ui-tags {
  margin-top: 18rpx;
  display: flex;
  flex-wrap: wrap;
}

.ui-body {
  padding: 28rpx 28rpx 0;
}

/* ---------------- 区块骨架 ---------------- */
.ui-section {
  background: var(--paper);
  border: 1rpx solid var(--line);
  border-radius: var(--r-lg);
  padding: 28rpx;
  margin-bottom: 22rpx;
  box-shadow: var(--sh-1);
}

.ui-section__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 22rpx;
}

.ui-section__title {
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: -0.01em;
  color: var(--ink);
}

.ui-section__meta {
  font-size: 20rpx;
  letter-spacing: 0.08em;
  color: var(--ink-5);
}

.ui-caption {
  font-size: 21rpx;
  font-weight: 600;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--ink-4);
  margin-bottom: 16rpx;
}

.ui-component-gap {
  margin-bottom: 30rpx;
}

/* ---------------- 色彩 ---------------- */
.ui-swatches {
  display: flex;
  gap: 12rpx;
}

.ui-swatch {
  flex: 1;
  min-width: 0;
}

.ui-swatch__chip {
  height: 92rpx;
  border-radius: var(--r-md);
  border: 1rpx solid var(--line);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
}

.ui-swatch__name {
  margin-top: 12rpx;
  font-size: 21rpx;
  font-weight: 600;
  color: var(--ink-2);
}

.ui-swatch__hex {
  margin-top: 2rpx;
  font-size: 18rpx;
  font-family: ui-monospace, Menlo, monospace;
  color: var(--ink-4);
}

.ui-swatch__note {
  font-size: 17rpx;
  color: var(--ink-5);
}

/* ---------------- 棱镜渐变 ---------------- */
.ui-prism {
  height: 76rpx;
  border-radius: var(--r-md);
}

.ui-prism__codes {
  display: flex;
  justify-content: space-between;
  margin-top: 14rpx;
}

.ui-prism__code {
  font-size: 17rpx;
  font-family: ui-monospace, Menlo, monospace;
  color: var(--ink-4);
  letter-spacing: 0.02em;
}

/* ---------------- 排版 ---------------- */
.ui-type {
  display: flex;
  gap: 26rpx;
  align-items: flex-start;
}

.ui-type__aa {
  font-size: 132rpx;
  font-weight: 300;
  line-height: 0.86;
  letter-spacing: -0.06em;
  color: var(--ink);
}

.ui-type__list {
  flex: 1;
  min-width: 0;
}

.ui-type__row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 9rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.ui-type__row:last-child {
  border-bottom: 0;
}

.ui-type__sample {
  font-size: 30rpx;
  color: var(--ink);
  width: 44rpx;
}

.ui-type__label {
  flex: 1;
  font-size: 22rpx;
  color: var(--ink-3);
  letter-spacing: 0.04em;
}

.ui-type__weight {
  font-size: 19rpx;
  color: var(--ink-5);
  font-family: ui-monospace, Menlo, monospace;
}

.ui-type__alphabet {
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--line);
  font-size: 19rpx;
  line-height: 1.8;
  color: var(--ink-4);
  letter-spacing: 0.03em;
  word-break: break-all;
}

/* ---------------- 图标 ---------------- */
.ui-icons {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.ui-icon {
  width: calc((100% - 60rpx) / 6);
  height: 104rpx;
  border-radius: var(--r-sm);
  background: var(--slate);
  border: 1rpx solid var(--line);
  display: flex;
  align-items: center;
  justify-content: center;
}

.ui-icon__img {
  width: 40rpx;
  height: 40rpx;
}

/* ---------------- 按钮 ---------------- */
.ui-btn-row {
  display: flex;
  gap: 18rpx;
  margin-bottom: 20rpx;
}

.ui-btn-col {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.ui-btn-col__label {
  font-size: 19rpx;
  letter-spacing: 0.1em;
  color: var(--ink-5);
}

.ui-text-btn {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink);
  padding: 14rpx 0;
}

.ui-text-btn--disabled {
  color: var(--ink-5);
}

.ui-btn-inline {
  display: flex;
  gap: 12rpx;
}

.ui-icon-btn {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  border: 1rpx solid var(--line-2);
  background: var(--paper);
  display: flex;
  align-items: center;
  justify-content: center;
}

.ui-icon-btn--disabled {
  opacity: 0.4;
}

.ui-icon-btn__glyph {
  font-size: 30rpx;
  color: var(--ink-2);
  line-height: 1;
}

/* ---------------- 导航模型 ---------------- */
.ui-nav {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 20rpx;
  border-radius: var(--r-md);
  border: 1rpx solid var(--line);
  background: var(--paper);
  margin-bottom: 14rpx;
}

.ui-nav__logo {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.ui-nav__mark {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: conic-gradient(from 210deg, #ffb27a, #ffd166, #6fe3e1, #a78bfa, #ff9ec4, #ffb27a);
}

.ui-nav__brand {
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 0.14em;
  color: var(--ink);
}

.ui-nav__links {
  display: flex;
  gap: 18rpx;
  margin-left: 10rpx;
  flex: 1;
}

.ui-nav__link {
  font-size: 21rpx;
  color: var(--ink-3);
}

.ui-nav__right {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-left: auto;
}

.ui-nav__search {
  font-size: 19rpx;
  color: var(--ink-5);
  border: 1rpx solid var(--line);
  border-radius: 999rpx;
  padding: 6rpx 16rpx;
  background: var(--slate);
}

.ui-nav__search--icon {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  font-size: 24rpx;
}

.ui-nav__login {
  font-size: 21rpx;
  color: var(--ink-2);
}

.ui-nav__cta {
  font-size: 20rpx;
  font-weight: 600;
  color: #fff;
  background: var(--ink);
  border-radius: 999rpx;
  padding: 9rpx 20rpx;
}

.ui-nav__burger {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  width: 44rpx;
  height: 44rpx;
  align-items: center;
  justify-content: center;
}

.ui-nav__burger-line {
  width: 26rpx;
  height: 2rpx;
  background: var(--ink-2);
}

/* ---------------- 卡片组件 ---------------- */
.ui-card2 {
  display: flex;
  gap: 18rpx;
  align-items: center;
}

.ui-card2__visual {
  position: relative;
  width: 168rpx;
  height: 130rpx;
  border-radius: var(--r-md);
  overflow: hidden;
  background: var(--slate);
  flex-shrink: 0;
}

.ui-card2__wave {
  position: absolute;
  left: -20%;
  right: -20%;
  height: 120rpx;
  border-radius: 50%;
  filter: blur(8rpx);
  opacity: 0.85;
}

.ui-card2__wave--a {
  bottom: -30rpx;
  background: linear-gradient(90deg, #ffb27a, #ffd166);
}

.ui-card2__wave--b {
  bottom: -50rpx;
  left: -40%;
  background: linear-gradient(90deg, #6fe3e1, #a78bfa);
  opacity: 0.7;
}

.ui-card2__wave--c {
  bottom: -66rpx;
  background: linear-gradient(90deg, #ff9ec4, #ffb27a);
  opacity: 0.55;
}

.ui-card2__body {
  flex: 1;
  min-width: 0;
}

.ui-card2__title {
  font-size: 27rpx;
  font-weight: 600;
  color: var(--ink);
  letter-spacing: -0.01em;
}

.ui-card2__desc {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: var(--ink-4);
  line-height: 1.6;
}

.ui-card2__btn {
  margin-top: 14rpx;
  width: 132rpx;
}

/* ---------------- 输入框 ---------------- */
.ui-field {
  margin-bottom: 16rpx;
}

.ui-field__label {
  font-size: 20rpx;
  letter-spacing: 0.06em;
  color: var(--ink-4);
  margin-bottom: 8rpx;
}

.ui-input {
  display: flex;
  align-items: center;
  gap: 10rpx;
  height: 76rpx;
  padding: 0 22rpx;
  border-radius: var(--r-md);
  border: 1rpx solid var(--line-2);
  background: var(--paper);
}

.ui-input__icon {
  font-size: 26rpx;
  color: var(--ink-5);
}

.ui-input__ph {
  font-size: 24rpx;
  color: var(--ink-5);
}

/* ---------------- 标签页 ---------------- */
.ui-tabs {
  display: flex;
  gap: 8rpx;
  padding: 6rpx;
  background: var(--slate);
  border-radius: 999rpx;
}

.ui-tab {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 23rpx;
  color: var(--ink-3);
  border-radius: 999rpx;
  transition: all 180ms var(--ease-out);
}

.ui-tab--on {
  background: var(--ink);
  color: #fff;
  font-weight: 600;
}

.ui-tab-panel {
  margin-top: 12rpx;
  font-size: 21rpx;
  color: var(--ink-4);
}

/* ---------------- 开关行 ---------------- */
.ui-switch-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.ui-switch-row:last-child {
  border-bottom: 0;
}

.ui-switch-row__title {
  font-size: 25rpx;
  font-weight: 600;
  color: var(--ink);
}

.ui-switch-row__desc {
  margin-top: 2rpx;
  font-size: 20rpx;
  color: var(--ink-4);
}

/* ---------------- 数据可视化 ---------------- */
.ui-viz {
  display: flex;
  align-items: center;
  gap: 26rpx;
  margin-bottom: 26rpx;
}

.ui-donut-wrap {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  flex-shrink: 0;
}

.donut {
  width: 200rpx;
  height: 200rpx;
  background: conic-gradient(
    #a78bfa 0deg 194deg,
    #6fe3e1 194deg 306deg,
    #ffd166 306deg 360deg
  );
}

.ui-donut__num {
  font-size: 38rpx;
  font-weight: 700;
  letter-spacing: -0.03em;
  color: var(--ink);
}

.ui-donut__cap {
  margin-top: 2rpx;
  font-size: 18rpx;
  color: var(--ink-4);
}

.ui-legend {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.ui-legend__item {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.ui-legend__dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.ui-legend__label {
  flex: 1;
  font-size: 21rpx;
  color: var(--ink-3);
}

.ui-legend__val {
  font-size: 21rpx;
  font-weight: 600;
  color: var(--ink);
  font-variant-numeric: tabular-nums;
}

.ui-chart {
  border-top: 1rpx solid var(--line);
  padding-top: 22rpx;
}

.ui-chart__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 18rpx;
}

.ui-chart__title {
  font-size: 23rpx;
  font-weight: 600;
  color: var(--ink-2);
}

.ui-chart__meta {
  font-size: 19rpx;
  color: var(--ink-5);
}

/* ---------------- 浏览器模型 ---------------- */
.ui-browser {
  border-radius: var(--r-lg);
  border: 1rpx solid var(--line);
  overflow: hidden;
  box-shadow: var(--sh-2);
}

.ui-browser__bar {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 14rpx 18rpx;
  background: var(--slate);
  border-bottom: 1rpx solid var(--line);
}

.ui-browser__dots {
  display: flex;
  gap: 8rpx;
}

.ui-browser__dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--line-2);
}

.ui-browser__url {
  flex: 1;
  font-size: 18rpx;
  color: var(--ink-4);
  background: var(--paper);
  border-radius: 999rpx;
  padding: 5rpx 16rpx;
}

.ui-browser__stage {
  position: relative;
  padding: 40rpx 28rpx 44rpx;
  background: linear-gradient(160deg, #ffffff 0%, #fafafc 60%, #f7f8fb 100%);
  overflow: hidden;
}

.ui-browser__wave {
  position: absolute;
  left: -20%;
  right: -20%;
  bottom: -140rpx;
  height: 300rpx;
  border-radius: 50%;
  background: conic-gradient(from 120deg, #ffb27a, #ffd166, #6fe3e1, #a78bfa, #ff9ec4, #ffb27a);
  filter: blur(26rpx);
  opacity: 0.45;
}

.ui-browser__content {
  position: relative;
  z-index: 1;
}

.ui-browser__eyebrow {
  font-size: 17rpx;
  font-weight: 700;
  letter-spacing: 0.28em;
  color: var(--ink-4);
}

.ui-browser__title {
  margin-top: 12rpx;
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: -0.035em;
  line-height: 1.16;
  color: var(--ink);
  width: 80%;
}

.ui-browser__actions {
  display: flex;
  gap: 14rpx;
  margin-top: 22rpx;
  width: 380rpx;
}

.ui-browser__partners {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 22rpx;
  border-top: 1rpx solid var(--line);
  background: var(--paper);
}

.ui-partner {
  font-size: 17rpx;
  font-weight: 700;
  letter-spacing: 0.16em;
  color: var(--ink-5);
}

/* ---------------- 手机模型 ---------------- */
.ui-phone {
  position: relative;
  width: 420rpx;
  margin: 0 auto;
  padding: 16rpx;
  border-radius: 52rpx;
  background: var(--paper);
  border: 1rpx solid var(--line);
  box-shadow: var(--sh-3);
}

.ui-phone__notch {
  position: absolute;
  top: 26rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 108rpx;
  height: 18rpx;
  border-radius: 999rpx;
  background: var(--slate);
  z-index: 2;
}

.ui-phone__screen {
  border-radius: 40rpx;
  background: linear-gradient(180deg, #ffffff, #fafafc);
  padding: 40rpx 22rpx 14rpx;
  overflow: hidden;
  position: relative;
}

.ui-phone__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.ui-phone__hi {
  font-size: 19rpx;
  color: var(--ink-4);
}

.ui-phone__avatar {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: var(--ink);
  color: #fff;
  font-size: 19rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ui-phone__balance {
  margin-top: 18rpx;
}

.ui-phone__label {
  font-size: 18rpx;
  letter-spacing: 0.08em;
  color: var(--ink-5);
}

.ui-phone__amount {
  margin-top: 4rpx;
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: -0.04em;
  color: var(--ink);
  font-variant-numeric: tabular-nums;
}

.ui-phone__delta {
  font-size: 18rpx;
  color: var(--ok);
}

.ui-phone__chart {
  display: flex;
  align-items: flex-end;
  gap: 8rpx;
  height: 70rpx;
  margin: 18rpx 0;
}

.ui-phone__bar {
  flex: 1;
  border-radius: 6rpx 6rpx 3rpx 3rpx;
  background: var(--grad-prism);
  opacity: 0.9;
}

.ui-phone__actions {
  display: flex;
  justify-content: space-between;
  padding: 14rpx 0;
  border-top: 1rpx solid var(--line);
  border-bottom: 1rpx solid var(--line);
}

.ui-phone__action {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.ui-phone__actionIcon {
  width: 52rpx;
  height: 52rpx;
  border-radius: 16rpx;
  background: var(--slate);
  display: flex;
  align-items: center;
  justify-content: center;
}

.ui-phone__actionGlyph {
  font-size: 22rpx;
  color: var(--ink-2);
}

.ui-phone__actionLabel {
  font-size: 17rpx;
  color: var(--ink-4);
}

.ui-phone__list {
  padding: 8rpx 0;
}

.ui-phone__item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.ui-phone__item:last-child {
  border-bottom: 0;
}

.ui-phone__itemDot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--spec-v);
  flex-shrink: 0;
}

.ui-phone__itemTitle {
  font-size: 19rpx;
  font-weight: 500;
  color: var(--ink-2);
}

.ui-phone__itemMeta {
  margin-top: 1rpx;
  font-size: 16rpx;
  color: var(--ink-5);
}

.ui-phone__itemTag {
  font-size: 16rpx;
  color: var(--ink-4);
  background: var(--slate);
  border-radius: 999rpx;
  padding: 3rpx 12rpx;
}

.ui-phone__tabbar {
  display: flex;
  justify-content: space-around;
  margin-top: 10rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid var(--line);
}

.ui-phone__tab {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: var(--ink-5);
}

.ui-phone__tab--on {
  background: var(--ink);
  color: #fff;
}

.ui-foot {
  margin-top: 26rpx;
  text-align: center;
  font-size: 19rpx;
  letter-spacing: 0.12em;
  color: var(--ink-5);
}
