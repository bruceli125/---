/* 需求详情 */
.info-grid {
  display: flex;
  flex-wrap: wrap;
}

.info-item {
  width: 50%;
  padding: 10rpx 0;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.info-label {
  font-size: 22rpx;
  color: var(--text-weak);
}

.info-value {
  font-size: 27rpx;
  color: var(--text-main);
  margin-top: 2rpx;
  word-break: break-all;
}

.info-block {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid var(--border-color);
}

.req-text {
  font-size: 27rpx;
  color: var(--text-sub);
  line-height: 1.75;
  white-space: pre-wrap;
}

.link-row {
  display: flex;
  gap: 24rpx;
}

.copy-link {
  font-size: 24rpx;
  color: var(--brand-primary);
}

/* ---------- 风险横幅 ---------- */
.risk-banner {
  border-radius: 20rpx;
  border: 2rpx solid transparent;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.risk-banner-head {
  display: flex;
  align-items: center;
}

.risk-badge {
  color: #ffffff;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  margin-right: 14rpx;
}

.risk-count {
  font-size: 26rpx;
  font-weight: 600;
}

.risk-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.7;
  opacity: 0.92;
}

.risk-high {
  margin-top: 14rpx;
  background-color: rgba(240, 68, 56, 0.12);
  color: #a21b12;
  font-size: 24rpx;
  font-weight: 600;
  border-radius: 12rpx;
  padding: 14rpx 18rpx;
  line-height: 1.6;
}

/* ---------- 风险词 / 提示 ---------- */
.hit-item {
  padding: 16rpx 0;
  border-bottom: 2rpx solid var(--border-color);
}

.hit-item:last-child {
  border-bottom: none;
}

.hit-tip {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-sub);
  line-height: 1.7;
}

.tip-item {
  font-size: 25rpx;
  color: var(--text-sub);
  line-height: 1.75;
  margin-bottom: 8rpx;
}

.empty-btn {
  width: 320rpx;
  margin: 28rpx auto 0;
}

/* ================================================================
 * 二期：履约与互评
 * ================================================================ */
.fulfill-card {
  border: 2rpx solid var(--trust-green);
  box-shadow: 0 6rpx 20rpx rgba(23, 178, 106, 0.12);
}

.matched-box {
  margin-top: 16rpx;
  background-color: var(--trust-green-soft);
  border-radius: 16rpx;
  padding: 20rpx;
}

.matched-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #0a7a52;
  margin-bottom: 6rpx;
}

.badge-line {
  margin-top: 12rpx;
}

.fulfill-sub {
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid var(--border-color);
}

.fulfill-label {
  font-size: 27rpx;
  font-weight: 600;
  color: var(--text-main);
}

.checkin-box {
  margin-top: 12rpx;
  background-color: var(--bg-gray);
  border-radius: 14rpx;
  padding: 18rpx;
}

.checkin-summary {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-sub);
  line-height: 1.65;
}

.fulfill-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 22rpx;
}

.review-state {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
  background-color: var(--brand-primary-soft);
  border-radius: 14rpx;
  padding: 14rpx 18rpx;
}

.review-state-label {
  font-size: 23rpx;
  color: var(--text-sub);
  margin-right: 12rpx;
}

.review-state-value {
  font-size: 25rpx;
  font-weight: 600;
  color: var(--brand-primary);
}

/* ---------- 确认成单（家长） ---------- */
.cand-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid var(--border-color);
}

.cand-item:last-child {
  border-bottom: none;
}

.cand-main {
  flex: 1;
  min-width: 0;
  padding-right: 16rpx;
}

.cand-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
}

.cand-reason {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--text-weak);
  line-height: 1.6;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cand-btn {
  flex: 0 0 auto;
  min-width: 176rpx;
}

/* ================= 三期：长按报名按钮 ================= */
.hold-btn {
  position: relative;
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  height: 88rpx;
  border-radius: 999rpx;
  background: var(--paper, #fff);
  border: 2rpx solid var(--line-2, #d8dbe4);
  transition: border-color 180ms ease;
}

.hold-btn--active {
  border-color: var(--ink, #0a0a0c);
}

.hold-btn__rw {
  position: relative;
  width: 44rpx;
  height: 44rpx;
  flex: 0 0 auto;
}

.hold-btn__ring {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
}

.hold-btn__hole {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  bottom: 6rpx;
  left: 6rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.hold-btn__pct {
  font-size: 15rpx;
  line-height: 1;
  color: var(--ink-3, #5c5f6b);
}

.hold-btn__text {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink, #0a0a0c);
}

/* ================= 三期：家长端沟通列表 ================= */
.chat-list-count {
  font-size: 21rpx;
  color: var(--ink-4, #8e929e);
}

.chat-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--line, #e6e8ef);
}

.chat-item:last-child {
  border-bottom: 0;
}

.chat-item__avatar {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
  color: #fff;
  background: linear-gradient(135deg, #ffb27a, #a78bfa);
}

.chat-item__main {
  flex: 1;
  min-width: 0;
}

.chat-item__name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink, #0a0a0c);
}

.chat-item__cert {
  margin-left: 8rpx;
  font-size: 18rpx;
  font-weight: 400;
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
  background: var(--ok-soft, #e6f7f1);
  color: var(--ok, #0e9f6e);
}

.chat-item__last {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: var(--ink-4, #8e929e);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.chat-item__side {
  flex: 0 0 auto;
  text-align: right;
}

.chat-item__badge {
  font-size: 19rpx;
  color: var(--ink-5, #b9bcc6);
}

.chat-item__enter {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: var(--violet, #6d4aff);
}
