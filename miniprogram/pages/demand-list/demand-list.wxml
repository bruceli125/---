<!--
  接单池（学生视图按设计图三重构）
  卡片层级：角标 → 标题+分类 → 报名提示条 → 胶囊标签 → 地址/要求 → 匹配度区块 → 底部操作
-->
<view class="page">

  <!-- 权限拦截占位 -->
  <view wx:if="{{blocked}}" class="card blocked">
    <view class="blocked__icon">🔒</view>
    <view class="blocked__title">仅学生可访问接单池</view>
    <view class="text-sub mt-8">当前身份为家长，正在为你返回首页。</view>
    <view class="btn btn-primary btn-sm mt-16" bindtap="goHome">返回首页</view>
  </view>

  <block wx:else>
    <!-- ================= 学生：可接订单 ================= -->
    <block wx:if="{{isTutor}}">
      <view class="head">
        <view class="head__title">接单池</view>
        <view class="head__sub">共 {{poolTotal}} 条 · 长按 2 秒报名</view>
      </view>

      <view wx:if="{{!loading && !pool.length}}" class="card">
        <view class="empty">
          <view class="empty-icon">📭</view>
          <view class="empty-text">暂时没有可接订单</view>
        </view>
      </view>

      <view class="dc" wx:for="{{pool}}" wx:key="demandId">

        <!-- 右上角状态角标 -->
        <view class="dc__badge {{item.statusClass}}">{{item.statusLabel}}</view>

        <view data-demandid="{{item.demandId}}" bindtap="onOpenDemand">
          <!-- 标题 + 分类 -->
          <view class="dc__title">{{item.title}}</view>
          <view class="dc__cat {{item.categoryClass}}">{{item.category}}</view>

          <!-- 已报名提示条 -->
          <view class="dc__notice" wx:if="{{item.applied}}">
            已投递，等待家长确认（可在详情查看进度）
          </view>

          <!-- 胶囊标签（自动换行） -->
          <view class="dc__tags">
            <view class="pill" wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">
              <text class="pill__dot"></text>{{tag}}
            </view>
          </view>

          <!-- 地址 / 特殊要求 -->
          <view class="dc__meta">
            <view class="dc__meta-row">
              <text class="dc__meta-key">地址</text>
              <text class="dc__meta-val {{item.addressText ? '' : 'dc__meta-val--empty'}}">{{item.addressText || '未填写地址'}}</text>
            </view>
            <view class="dc__meta-row">
              <text class="dc__meta-key">要求</text>
              <text class="dc__meta-val dc__meta-val--clamp {{item.specialRequirements ? '' : 'dc__meta-val--empty'}}">{{item.specialRequirements || '家长未填写特殊要求'}}</text>
            </view>
          </view>

          <!-- 匹配度区块 -->
          <view class="dc__match">
            <view class="dc__match-title">匹配度 {{item.matchScore}} 分</view>
            <view class="dc__match-row">
              <text class="dc__match-item">需求匹配度 {{item.matchScore}} 分</text>
              <text class="dc__match-sep">·</text>
              <text class="dc__match-item">{{item.distanceText}}</text>
              <text class="dc__match-sep">·</text>
              <text class="dc__match-item {{item.overBudget ? 'dc__match-item--warn' : ''}}">{{item.priceNote}}</text>
            </view>
          </view>
        </view>

        <!-- 底部操作 -->
        <view class="dc__foot">
          <view class="dc__foot-left">
            <text class="dc__time">{{item.timeText}}</text>
            <text class="dc__count">{{item.applyCount}}人已申请 · {{item.viewCount}}次浏览</text>
          </view>

          <view class="dc__foot-right">
            <!--
              已报名：卡片不消失，右侧换成「取消报名 + 去沟通」
              （是否已报名 = applied.has(demandId)，在 JS 的 buildCard 里算好）
            -->
            <block wx:if="{{item.applied}}">
              <text class="dc__cancel" data-demandid="{{item.demandId}}" catchtap="onCancelSignup">取消报名</text>
              <view class="dc__done" data-demandid="{{item.demandId}}" catchtap="goChat">
                <text class="dc__done-check">💬</text>去沟通
              </view>
            </block>

            <view wx:else class="dc__hold">
              <hold-button
                label="长按报名"
                duration="{{2000}}"
                demand-id="{{item.demandId}}"
                bind:confirm="onSignup"
              />
            </view>
          </view>
        </view>
      </view>
    </block>

    <!-- ================= 家长：我的需求 ================= -->
    <block wx:else>
      <view class="head">
        <view class="head__title">我的需求</view>
        <view class="head__sub">共 {{mineTotal}} 条 · 点进去查看申请接单的学生</view>
      </view>

      <view class="btn btn-primary btn-block create-btn" bindtap="goCreate">＋ 发布新需求</view>

      <view wx:if="{{!loading && !mine.length}}" class="card">
        <view class="empty">
          <view class="empty-icon">📝</view>
          <view class="empty-text">还没有发布需求</view>
        </view>
      </view>

      <view class="card mine-item" wx:for="{{mine}}" wx:key="id" data-id="{{item.id}}" bindtap="onOpenMine">
        <view class="mine-item__top">
          <text class="mine-item__title">{{item.title}}</text>
          <text class="tag tag-blue">{{item.statusLabel}}</text>
        </view>
        <view class="mine-item__meta">{{item.budgetText}} · {{item.applyCount}} 人申请 · {{item.createdAt}}</view>
        <view class="mine-item__go">查看申请与沟通 ›</view>
      </view>
    </block>

    <view class="loading" wx:if="{{loading}}">正在加载…</view>
    <platform-notice />
  </block>
</view>
