/* 接单池：学生池子 / 家长我的需求 / 权限占位 */
.head {
  padding: 8rpx 4rpx 24rpx;
}

.head__title {
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: -0.03em;
  color: var(--ink, #0a0a0c);
}

.head__sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--ink-4, #8e929e);
}

/* ---------- 权限占位 ---------- */
.blocked {
  text-align: center;
  padding: 64rpx 40rpx;
}

.blocked__icon {
  font-size: 76rpx;
  line-height: 1;
}

.blocked__title {
  margin-top: 22rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ink, #0a0a0c);
}

.blocked .btn {
  display: inline-flex;
  margin-top: 26rpx;
}

/* ---------- 学生：订单卡片 ---------- */
.pool-item {
  padding: 26rpx 28rpx;
}

.pool-item__top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.pool-item__title {
  font-size: 31rpx;
  font-weight: 600;
  color: var(--ink, #0a0a0c);
}

.pool-item__score {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--violet, #6d4aff);
  flex: 0 0 auto;
}

.pool-item__meta {
  margin-top: 14rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.pool-item__time {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--ink-4, #8e929e);
}

.pool-item__status {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.pool-item__action {
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--line, #e6e8ef);
  display: flex;
  justify-content: flex-end;
}

/* ---------- 家长：我的需求 ---------- */
.create-btn {
  margin-bottom: 24rpx;
}

.mine-item {
  padding: 26rpx 28rpx;
}

.mine-item__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.mine-item__title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink, #0a0a0c);
}

.mine-item__meta {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--ink-4, #8e929e);
}

.mine-item__go {
  margin-top: 12rpx;
  font-size: 23rpx;
  color: var(--violet, #6d4aff);
}
