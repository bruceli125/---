/* 我的页面样式 */
.page {
  padding-bottom: 60rpx;
}

/* ---------- 用户卡 ---------- */
.user-card {
  background: linear-gradient(150deg, #fafafc, #ffffff);
  border: 2rpx solid var(--brand-primary-soft);
}

/* ---------- 头像 / 昵称自定义 ---------- */
.avatar-btn {
  position: relative;
  width: 108rpx;
  height: 108rpx;
  padding: 0;
  margin: 0 20rpx 0 0;
  border-radius: 50%;
  background: transparent;
  line-height: 1;
  overflow: hidden;
}

.avatar-btn::after {
  border: none;
}

.user-avatar-img {
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  display: block;
}

.avatar-edit {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: rgba(10, 10, 12, 0.72);
  color: #fff;
  font-size: 18rpx;
  line-height: 36rpx;
  text-align: center;
}

.user-info {
  flex: 1;
  min-width: 0;
}

.user-name-input {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--ink, #0a0a0c);
  padding: 4rpx 0;
  min-height: 48rpx;
}

.chip-add {
  border-style: dashed;
  color: var(--violet, #6d4aff);
  border-color: rgba(109, 74, 255, 0.4);
}

.user-avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 42rpx;
  font-weight: 600;
  background: linear-gradient(135deg, #6d4aff, #0a0a0c);
}

.user-name {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-main);
}

.user-meta {
  display: flex;
  align-items: flex-start;
  margin-top: 10rpx;
}

.user-meta-label {
  width: 150rpx;
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--text-weak);
}

.user-meta-value {
  flex: 1;
  font-size: 24rpx;
  color: var(--text-sub);
  word-break: break-all;
}

/* ---------- 数据卡 ---------- */
.stat-grid {
  display: flex;
  flex-wrap: wrap;
}

.stat-item {
  width: 25%;
  text-align: center;
  padding: 10rpx 0;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-main);
  line-height: 1.2;
}

.stat-value.green {
  color: var(--trust-green);
}

.stat-value.warn {
  color: var(--warn-orange);
}

.stat-label {
  font-size: 22rpx;
  color: var(--text-weak);
  margin-top: 6rpx;
}

/* ---------- 功能入口 ---------- */
.entry-row {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 2rpx solid var(--border-color);
}

.entry-row:last-child {
  border-bottom: none;
}

.entry-icon {
  font-size: 38rpx;
  margin-right: 18rpx;
}

.entry-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
}

.entry-arrow {
  font-size: 26rpx;
  color: var(--brand-primary);
  flex-shrink: 0;
}

/* ---------- 报告列表 ---------- */
.report-list {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid var(--border-color);
}

.report-item {
  padding: 20rpx;
  border-radius: var(--radius-md);
  background-color: var(--bg-gray);
  margin-bottom: 16rpx;
}

.report-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
}

/* ---------- 认证 ---------- */
.cert-hint {
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
  border-radius: var(--radius-md);
  background-color: var(--warn-orange-soft);
  color: var(--warn-orange);
  font-size: 24rpx;
  line-height: 1.6;
}

.cert-item {
  padding: 20rpx 0;
  border-bottom: 2rpx solid var(--border-color);
}

.cert-item:last-child {
  border-bottom: none;
}

.cert-type {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
}

.cert-action {
  font-size: 24rpx;
  color: var(--brand-primary);
  text-decoration: underline;
}

.cert-note {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: var(--text-sub);
  line-height: 1.6;
}

/* ---------- 申请列表 ---------- */
.app-item {
  padding: 20rpx 0;
  border-bottom: 2rpx solid var(--border-color);
}

.app-item:last-child {
  border-bottom: none;
}

.app-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
}

/* ---------- 关于 ---------- */
.about-row {
  display: flex;
  align-items: flex-start;
  padding: 10rpx 0;
}

.about-label {
  width: 180rpx;
  flex-shrink: 0;
  font-size: 25rpx;
  color: var(--text-weak);
}

.about-value {
  flex: 1;
  font-size: 25rpx;
  color: var(--text-main);
  word-break: break-all;
}

/* ---------- 免责声明 ---------- */
.disclaimer-item {
  font-size: 23rpx;
  color: var(--text-weak);
  line-height: 1.75;
  margin-top: 8rpx;
}

/* ---------- 隐私与授权（与微信后台声明的信息类型一一对应） ---------- */
.privacy-row {
  padding: 16rpx 0;
  border-bottom: 2rpx solid var(--border-color);
}

.privacy-row:last-child {
  border-bottom: none;
}

.privacy-type {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-main);
}

.privacy-purpose {
  display: block;
  font-size: 23rpx;
  color: var(--text-weak);
  line-height: 1.6;
  margin-top: 4rpx;
}

.version-line {
  text-align: center;
  font-size: 22rpx;
  color: var(--text-weak);
  padding: 20rpx 0 40rpx;
}

.empty-btn {
  width: 360rpx;
  margin: 24rpx auto 0;
}

/* ============================================================================
 * 个人信息区（Flex 布局重构）
 * 左：120rpx 圆形头像；右：昵称 + 角色；右侧：切换身份
 * ========================================================================== */
.user-head {
  display: flex;
  align-items: center;
  width: 100%;
}

.avatar-btn {
  position: relative;
  flex: 0 0 auto;
  width: 120rpx;
  height: 120rpx;
  padding: 0;
  margin: 0;
  border-radius: 50%;
  background: transparent;
  line-height: 1;
  overflow: visible;
}

.avatar-btn::after {
  border: none;
}

.avatar-img {
  display: block;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #f2f4f8;
}

.avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  font-size: 44rpx;
  font-weight: 600;
  color: #ffffff;
  background: linear-gradient(135deg, #ffb27a, #a78bfa);
}

.avatar-edit {
  position: absolute;
  right: -2rpx;
  bottom: -2rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(10, 10, 12, 0.72);
  color: #ffffff;
  font-size: 18rpx;
  line-height: 40rpx;
  text-align: center;
  box-shadow: 0 0 0 3rpx #ffffff;
}

.user-main {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
}

.user-name {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--ink, #0a0a0c);
  line-height: 1.3;
  min-height: 46rpx;
}

.nickname-ph {
  color: #b9bcc6;
  font-weight: 500;
}

.user-role {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--ink-4, #8e929e);
}

.role-switch {
  flex: 0 0 auto;
  margin-left: 16rpx;
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--line-2, #d8dbe4);
  font-size: 22rpx;
  color: var(--ink-3, #5c5f6b);
}

/* ===== 用户头部：最终覆盖（修复头像与昵称间的大空白） ===== */
/* 外层：横向 flex + 垂直居中，子项紧挨着排 */
.user-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-start;
  width: 100%;
}

/* 头像：固定尺寸圆形，右侧留 30rpx，不留其他外边距 */
.user-head .avatar-btn {
  flex: 0 0 auto;
  width: 120rpx;
  height: 120rpx;
  min-width: 120rpx;
  padding: 0;
  margin: 0 30rpx 0 0;      /* 关键：只留右边距，消除中间大空白 */
  border-radius: 50%;
  background: transparent;
  line-height: 1;
  overflow: visible;
}

.user-head .avatar-btn::after {
  border: none;              /* 去掉小程序 button 默认边框 */
}

/* 中间信息区：占满剩余空间，内部纵向左对齐 */
.user-head .user-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  margin-left: 0;            /* 清除旧的 margin-left: 24rpx，间距统一由头像右边距控制 */
}

/* 第一行：昵称（加大加粗，输入框铺满信息区宽度） */
.user-head .user-name {
  width: 100%;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.25;
  color: var(--ink, #0a0a0c);
  padding: 0;
  min-height: 44rpx;
  text-align: left;
}

.user-head .nickname-ph {
  color: #b9bcc6;
  font-weight: 500;
}

/* 第二行：学校 · 角色（小字、浅色、同一行） */
.user-head .user-sub {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--ink-4, #8e929e);
  max-width: 100%;
}

.user-head .user-school {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  max-width: 60%;
}

.user-head .user-dot {
  color: #c9ccd4;
}

.user-head .user-role {
  flex: 0 0 auto;
  margin: 0;
  font-size: 22rpx;
  color: var(--ink-4, #8e929e);
}

/* 右侧按钮：胶囊形、白底、浅边框、小字号，自动贴右边 */
.user-head .role-switch {
  flex: 0 0 auto;
  margin-left: 16rpx;
  padding: 10rpx 22rpx;
  border-radius: 30rpx;
  background: #ffffff;
  border: 1rpx solid var(--line-2, #d8dbe4);
  font-size: 22rpx;
  line-height: 1.4;
  color: var(--ink-3, #5c5f6b);
  white-space: nowrap;
}
