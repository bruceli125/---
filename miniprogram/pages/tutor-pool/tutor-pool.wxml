<!--
  学生接单池（二期重构）
  结构：家长身份提示 → 我的状态卡 → 三组筛选 → 订单状态 Tabs → 排序说明 → 订单列表 → 平台定位声明
-->
<view class="page">

  <!--
    权限拦截（三期修复角色越权）
    非师范生进入本页时只渲染这块占位，列表完全不渲染，随后由 app.guardRole 自动退回首页。
  -->
  <view wx:if="{{blocked}}" class="card blocked-card">
    <view class="blocked-icon">🔒</view>
    <view class="blocked-title">仅师范生可进入接单池</view>
    <view class="text-sub mt-8">接单池用于接收家长需求并报名沟通。当前身份为家长，正在为你返回首页。</view>
    <view class="btn btn-primary btn-sm mt-16" bindtap="onGoHome">返回首页</view>
  </view>

  <block wx:if="{{!blocked}}">

  <!-- ================= 我的状态卡 ================= -->
  <view class="card my-card">
    <view class="row-between">
      <view class="row flex-1">
        <view class="my-avatar">{{myAvatarText}}</view>
        <view class="flex-1">
          <view class="my-name">{{myName}}</view>
          <view class="text-weak my-school">{{mySchoolLine}}</view>
        </view>
      </view>
      <view class="credit-box">
        <view class="credit-value">{{creditScore}}</view>
        <view class="credit-label">信用分</view>
      </view>
    </view>

    <view class="credit-tip-line">
      <text class="credit-tip">{{creditLevelText}}</text>
      <text class="text-weak">信用分区间 {{creditRangeText}} · 已收到 {{reviewCount}} 条评价</text>
    </view>

    <view class="my-stats">
      <view class="my-stat">
        <view class="my-stat-value">{{orderCount}}</view>
        <view class="my-stat-label">累计接单</view>
      </view>
      <view class="my-stat">
        <view class="my-stat-value">{{rating}}</view>
        <view class="my-stat-label">综合评分</view>
      </view>
      <view class="my-stat">
        <view class="my-stat-value">{{applyCount}}</view>
        <view class="my-stat-label">我的投递</view>
      </view>
      <view class="my-stat">
        <view class="my-stat-value">{{pendingCount}}</view>
        <view class="my-stat-label">待确认</view>
      </view>
    </view>

    <!-- 认证徽章（认证等级 + 唯一编号） -->
    <view class="cert-line">
      <cert-badge
        size="sm"
        level="{{certLevel}}"
        name="{{myName}}"
        badge-no="{{certBadgeNo}}"
        show-detail="{{false}}"
      />
      <text class="cert-level-text">{{certLevelText}}</text>
    </view>

    <view wx:if="{{!certified}}" class="cert-hint">
      <view class="flex-1">
        <view class="cert-hint-title">完成三重认证可提升匹配排序</view>
        <view class="text-weak">三重认证师范生在同分情况下排序更靠前，家长信任度也更高。</view>
      </view>
      <view class="btn btn-green btn-sm" bindtap="onGoVerify">去认证</view>
    </view>
  </view>

  <!-- ================= 三组筛选 ================= -->
  <view class="card filter-card">
    <!-- 1. 科目 Tab（横向滚动） -->
    <view class="filter-label">科目</view>
    <scroll-view class="tab-scroll" scroll-x="{{true}}">
      <view
        class="{{item.className}}"
        wx:for="{{subjectTabs}}"
        wx:key="value"
        data-value="{{item.value}}"
        bindtap="onSubjectTap"
      >{{item.label}}</view>
    </scroll-view>

    <!-- 2. 授课方式 Tab（横向滚动） -->
    <view class="filter-label mt-24">授课方式</view>
    <scroll-view class="tab-scroll" scroll-x="{{true}}">
      <view
        class="{{item.className}}"
        wx:for="{{modeTabs}}"
        wx:key="value"
        data-value="{{item.value}}"
        bindtap="onModeTap"
      >{{item.label}}</view>
    </scroll-view>

    <!-- 3. 匹配度开关 -->
    <view class="row-between match-switch">
      <view class="flex-1">
        <view class="text-bold">{{minMatchLabel}}</view>
        <view class="text-weak">{{matchHintText}}</view>
      </view>
      <switch checked="{{onlyHighMatch}}" color="#1F4FBF" bindchange="onToggleHighMatch" />
    </view>
  </view>

  <!-- ================= 订单状态 Tabs（横向滚动 + 计数角标） ================= -->
  <view class="status-block">
    <view class="row-between status-block-head">
      <view class="section-title-plain">订单状态</view>
      <text class="text-weak">{{countsText}}</text>
    </view>
    <scroll-view class="tab-scroll status-scroll" scroll-x="{{true}}">
      <view
        class="{{item.className}}"
        wx:for="{{statusTabs}}"
        wx:key="value"
        data-value="{{item.value}}"
        bindtap="onStatusTap"
      >
        <view class="status-tab-top">
          <text class="status-tab-label">{{item.label}}</text>
          <text class="status-tab-count">{{item.countText}}</text>
        </view>
        <text class="status-tab-desc">{{item.desc}}</text>
      </view>
    </scroll-view>
  </view>

  <!-- ================= 排序说明 ================= -->
  <view class="rules-line">{{sortNote}}</view>

  <view class="row-between list-head">
    <view class="section-title-plain">可接订单</view>
    <text class="text-weak">共 {{totalCount}} 条</text>
  </view>

  <!-- ================= 订单列表 ================= -->
  <view wx:if="{{loading}}" class="loading">正在加载接单池…</view>

  <block wx:else>
    <!-- 空状态：按当前筛选条件给出可执行的下一步 -->
    <view wx:if="{{!list.length}}" class="empty">
      <view class="empty-icon">{{emptyIcon}}</view>
      <view class="empty-text">{{emptyText}}</view>
      <view wx:if="{{showResetFilter}}" class="btn btn-ghost btn-sm mt-24 empty-btn" bindtap="onResetFilter">重置筛选</view>
    </view>

    <demand-card
      wx:for="{{list}}"
      wx:key="demandId"
      demand="{{item.demand}}"
      score="{{item.matchScore}}"
      reasons="{{item.reasons}}"
      show-risk="{{true}}"
      show-status="{{true}}"
      show-meta="{{true}}"
      show-apply="{{true}}"
      applied="{{item.applied}}"
      show-checkin-badge="{{item.showCheckin}}"
      order-hint="{{item.orderHint}}"
      apply-text="申请接单"
      bind:tap="onDemandTap"
      bind:apply="onApply"
      bind:cancel="onCancelApply"
    />
  </block>

  <!-- 合规红线：平台定位声明（非培训机构 / 非办学场所） -->
  <platform-notice />
  </block>
</view>
