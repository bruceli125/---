/* 学生接单池（二期重构） */

.page {
  padding-bottom: 60rpx;
}

/* ---------- 家长身份提示 ---------- */
.role-hint {
  background: linear-gradient(160deg, #fff8ec, #ffffff);
  border: 2rpx solid var(--warn-orange-soft);
}

.role-hint-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--warn-orange);
}

/* ---------- 我的状态卡 ---------- */
.my-card {
  background: linear-gradient(150deg, #f4f8ff, #ffffff);
  border: 2rpx solid var(--brand-primary-soft);
}

.my-avatar {
  width: 96rpx;
  height: 96rpx;
  flex-shrink: 0;
  border-radius: 50%;
  margin-right: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 40rpx;
  font-weight: 600;
  background: linear-gradient(135deg, #4f86f7, #1f4fbf);
}

.my-name {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-main);
}

.my-school {
  margin-top: 4rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.credit-box {
  flex-shrink: 0;
  text-align: right;
  padding-left: 16rpx;
}

.credit-value {
  font-size: 56rpx;
  font-weight: 700;
  color: var(--trust-green);
  line-height: 1.05;
}

.credit-label {
  font-size: 22rpx;
  color: var(--text-weak);
}

.credit-tip-line {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.credit-tip {
  font-size: 21rpx;
  font-weight: 600;
  color: var(--trust-green);
  background-color: var(--trust-green-soft);
  border-radius: 999rpx;
  padding: 3rpx 14rpx;
  margin-right: 12rpx;
}

.my-stats {
  display: flex;
  margin: 20rpx 0;
  padding: 20rpx 0;
  border-top: 2rpx solid var(--border-color);
  border-bottom: 2rpx solid var(--border-color);
}

.my-stat {
  flex: 1;
  text-align: center;
}

.my-stat-value {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-main);
}

.my-stat-label {
  font-size: 22rpx;
  color: var(--text-weak);
  margin-top: 4rpx;
}

/* 认证徽章行 */
.cert-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 4rpx;
}

.cert-level-text {
  font-size: 23rpx;
  font-weight: 600;
  color: var(--text-sub);
}

.cert-hint {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: var(--radius-md);
  background-color: var(--trust-green-soft);
}

.cert-hint-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--trust-green);
}

/* ---------- 筛选区 ---------- */
.filter-card {
  padding: 24rpx 24rpx 20rpx;
}

.filter-label {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 14rpx;
}

/* 横向滚动容器：white-space: nowrap + 子项 inline-block，避免换行 */
.tab-scroll {
  width: 100%;
  white-space: nowrap;
}

.tab-item {
  display: inline-block;
  padding: 10rpx 26rpx;
  margin-right: 14rpx;
  border-radius: 999rpx;
  background-color: var(--bg-gray);
  color: var(--text-sub);
  font-size: 25rpx;
  line-height: 1.6;
}

.tab-item-active {
  background-color: var(--brand-primary-soft);
  color: var(--brand-primary);
  font-weight: 600;
  box-shadow: inset 0 0 0 2rpx var(--brand-primary);
}

.match-switch {
  margin-top: 26rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid var(--border-color);
}

/* ---------- 订单状态 Tabs ---------- */
.status-block {
  background-color: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 24rpx 24rpx 20rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-card);
}

.status-block-head {
  margin-bottom: 16rpx;
}

.status-scroll {
  white-space: nowrap;
}

.status-tab {
  display: inline-block;
  vertical-align: top;
  min-width: 190rpx;
  padding: 16rpx 22rpx;
  margin-right: 16rpx;
  border-radius: var(--radius-md);
  background-color: #ffffff;
  border: 2rpx solid var(--border-color);
  white-space: normal;
}

.status-tab-active {
  background-color: var(--brand-primary-soft);
  border-color: var(--brand-primary);
  box-shadow: 0 6rpx 16rpx rgba(31, 79, 191, 0.12);
}

.status-tab-top {
  display: flex;
  align-items: center;
}

.status-tab-label {
  font-size: 27rpx;
  font-weight: 600;
  color: var(--text-main);
}

.status-tab-active .status-tab-label {
  color: var(--brand-primary);
}

.status-tab-count {
  margin-left: 10rpx;
  min-width: 34rpx;
  padding: 0 8rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  border-radius: 999rpx;
  background-color: rgba(31, 79, 191, 0.1);
  color: var(--brand-primary);
  font-size: 20rpx;
  font-weight: 700;
}

.status-tab-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 21rpx;
  color: var(--text-weak);
}

/* ---------- 排序说明 / 列表头 ---------- */
.rules-line {
  margin: 0 4rpx 18rpx;
  padding: 14rpx 20rpx;
  border-radius: var(--radius-sm);
  background-color: var(--bg-gray);
  font-size: 22rpx;
  color: var(--text-weak);
  line-height: 1.6;
}

.list-head {
  margin: 8rpx 4rpx 20rpx;
}

/* ---------- 空状态 ---------- */
.empty-btn {
  width: 260rpx;
  margin: 24rpx auto 0;
}
