/* 聊天室：整页三段式（头部信息 / 消息流 / 输入与确认） */
.room {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--snow, #fafafc);
}

/* ---------- 顶部 ---------- */
.room-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 28rpx;
  background: var(--paper, #fff);
  border-bottom: 1rpx solid var(--line, #e6e8ef);
}

.room-head__main {
  flex: 1;
  min-width: 0;
}

.room-head__title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink, #0a0a0c);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.room-head__sub {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: var(--ink-4, #8e929e);
}

.room-head__state {
  margin-left: 4rpx;
  color: var(--ink-3, #5c5f6b);
}

.room-head__state--communicating {
  color: var(--violet, #6d4aff);
}

.room-head__state--matched {
  color: var(--ok, #0e9f6e);
}

.room-head__arrow {
  font-size: 32rpx;
  color: var(--ink-5, #b9bcc6);
}

/* ---------- 协商进度 ---------- */
.nego {
  display: flex;
  gap: 20rpx;
  padding: 14rpx 28rpx;
  background: var(--paper, #fff);
  border-bottom: 1rpx solid var(--line, #e6e8ef);
}

.nego__who {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 21rpx;
  color: var(--ink-3, #5c5f6b);
}

.nego__dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--line-2, #d8dbe4);
  flex: 0 0 auto;
}

.nego__dot--on {
  background: var(--ok, #0e9f6e);
}

.nego__done {
  margin: 16rpx 24rpx 0;
  padding: 18rpx 20rpx;
  border-radius: var(--r-sm, 12rpx);
  font-size: 23rpx;
  font-weight: 600;
  color: var(--ink, #0a0a0c);
  background: var(--grad-prism-soft, linear-gradient(120deg, #fff3e8, #f3efff));
  border: 1rpx solid rgba(167, 139, 250, 0.28);
}

/* ---------- 消息流 ---------- */
.room-body {
  flex: 1;
  min-height: 0;
  padding: 16rpx 24rpx 0;
  box-sizing: border-box;
}

.room-empty {
  padding: 120rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: var(--ink-5, #b9bcc6);
}

.room-sys {
  margin: 14rpx auto;
  max-width: 86%;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  line-height: 1.6;
  text-align: center;
  color: var(--ink-4, #8e929e);
  background: var(--slate, #f2f4f8);
}

.room-row {
  display: flex;
  margin-top: 18rpx;
}

.room-row--mine {
  justify-content: flex-end;
}

.room-bubble {
  max-width: 78%;
  padding: 18rpx 22rpx;
  border-radius: 22rpx 22rpx 22rpx 6rpx;
  background: var(--paper, #fff);
  border: 1rpx solid var(--line, #e6e8ef);
}

.room-bubble--mine {
  border-radius: 22rpx 22rpx 6rpx 22rpx;
  background: var(--ink, #0a0a0c);
  border-color: var(--ink, #0a0a0c);
}

.room-text {
  font-size: 26rpx;
  line-height: 1.65;
  color: var(--ink, #0a0a0c);
  word-break: break-all;
}

.room-bubble--mine .room-text {
  color: #fff;
}

.room-auto {
  margin-top: 8rpx;
  font-size: 18rpx;
  color: var(--ink-4, #8e929e);
}

.room-bubble--mine .room-auto {
  color: rgba(255, 255, 255, 0.6);
}

.room-time {
  margin: 6rpx 0 0 6rpx;
  font-size: 18rpx;
  color: var(--ink-5, #b9bcc6);
}

.room-time--mine {
  text-align: right;
  margin-right: 6rpx;
}

/* ---------- 预设话术 ---------- */
.room-presets {
  white-space: nowrap;
  padding: 12rpx 24rpx;
  background: var(--paper, #fff);
  border-top: 1rpx solid var(--line, #e6e8ef);
}

.room-preset {
  display: inline-block;
  margin-right: 12rpx;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  color: var(--ink-3, #5c5f6b);
  background: var(--slate, #f2f4f8);
  border: 1rpx solid var(--line, #e6e8ef);
}

/* ---------- 输入 ---------- */
.room-input {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 14rpx 24rpx;
  background: var(--paper, #fff);
}

.room-input__box {
  flex: 1;
  min-width: 0;
  height: 76rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: var(--slate, #f2f4f8);
  font-size: 26rpx;
  color: var(--ink, #0a0a0c);
}

.room-input__send {
  flex: 0 0 auto;
  height: 76rpx;
  padding: 0 32rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--ink, #0a0a0c);
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
}

.room-input__send--off {
  opacity: 0.5;
}

/* ---------- 底部确认 ---------- */
.room-footer {
  padding: 14rpx 24rpx calc(14rpx + env(safe-area-inset-bottom));
  background: var(--paper, #fff);
  border-top: 1rpx solid var(--line, #e6e8ef);
}

.room-btn {
  height: 88rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
  background: var(--ink, #0a0a0c);
}

.room-btn--wait {
  background: var(--slate, #f2f4f8);
  color: var(--ink-4, #8e929e);
}

.room-btn--done {
  background: var(--ok-soft, #e6f7f1);
  color: var(--ok, #0e9f6e);
}
