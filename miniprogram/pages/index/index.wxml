<!-- 首页 / 角色选择 -->
<view class="index-page">

  <!-- 品牌区：折射光环 + 虹彩光谱（LIGHTCORE PRISM 主视觉） -->
  <view class="hero">
    <view class="hero-wash"></view>
    <view class="hero-ring">
      <view class="prism-halo"></view>
      <view class="prism-ring"></view>
    </view>

    <view class="hero-inner">
      <view class="hero-eyebrow">LIGHTCORE PRISM</view>
      <view class="hero-title">{{brand.name}}</view>
      <view class="prism-bar hero-bar"></view>
      <view class="hero-slogan">{{brand.slogan}}</view>
      <view class="hero-desc">{{brand.desc}}</view>
      <view class="hero-tags">
        <text class="tag tag-prism">认证可查</text>
        <text class="tag tag-line">试课可换</text>
        <text class="tag tag-line">学生零押金</text>
      </view>
      <view class="hero-version">v{{brand.version}} · 可信对接 · 智能匹配</view>
    </view>
  </view>

  <view class="index-body">

    <!-- 信任点 -->
    <view class="trust-bar">
      <view class="trust-item" wx:for="{{trustPoints}}" wx:key="title">
        <view class="trust-item-icon">{{item.icon}}</view>
        <view class="trust-item-title">{{item.title}}</view>
        <view class="trust-item-sub">{{item.desc}}</view>
      </view>
    </view>
    <view class="core-ability">{{coreAbility}}</view>

    <!-- 设计系统入口（浅色虹彩主题说明页） -->
    <view class="design-entry" bindtap="goUiKit">
      <view class="design-entry__ring"></view>
      <view class="flex-1">
        <view class="design-entry__title">LIGHTCORE PRISM 设计系统</view>
        <view class="design-entry__sub">色彩 · 棱镜渐变 · 排版 · 组件 · 图表</view>
      </view>
      <view class="design-entry__arrow">›</view>
    </view>

    <!-- 角色选择 -->
    <view class="section-title mt-24">选择您的身份</view>
    <view class="role-grid">
      <view
        class="role-card {{role === item.value ? 'role-card-active' : ''}}"
        wx:for="{{roleCards}}"
        wx:key="value"
        data-role="{{item.value}}"
        bindtap="onSelectRole"
      >
        <view class="role-check" wx:if="{{role === item.value}}">✓</view>
        <view class="role-icon">{{item.icon}}</view>
        <view class="role-title">{{item.title}}</view>
        <view class="role-sub">{{item.sub}}</view>
        <view class="role-desc">{{item.desc}}</view>
      </view>
    </view>
    <view class="role-current">
      <text class="text-weak">当前身份：</text>
      <text class="text-bold {{role ? 'text-blue' : 'text-weak'}}">{{roleLabel}}</text>
    </view>

    <!-- 家长入口 -->
    <view class="card" wx:if="{{role === 'parent'}}">
      <view class="row-between">
        <view class="card-title">家长服务</view>
        <view class="tag tag-blue">找家教</view>
      </view>

      <view class="stat-grid mt-16">
        <view class="stat-cell">
          <view class="stat-num">{{stats.demandCount}}</view>
          <view class="stat-label">我的需求</view>
        </view>
        <view class="stat-cell">
          <view class="stat-num">{{stats.publishedCount}}</view>
          <view class="stat-label">招募中</view>
        </view>
        <view class="stat-cell">
          <view class="stat-num">{{stats.reportCount}}</view>
          <view class="stat-label">对接报告</view>
        </view>
        <view class="stat-cell">
          <view class="stat-num {{stats.riskCount > 0 ? 'text-red' : ''}}">{{stats.riskCount}}</view>
          <view class="stat-label">风险需求</view>
        </view>
      </view>

      <view class="btn btn-primary mt-16" bindtap="goCreateDemand">发布家教需求</view>
      <view class="btn btn-ghost mt-16" bindtap="goDemandList">我的需求（{{stats.demandCount}}）</view>

      <view class="report-hint mt-16">
        <view class="report-hint-title">📄 我的对接报告</view>
        <view class="text-weak">在「我的需求」→ 需求详情 →「生成对接报告」中查看与复制。</view>
      </view>
    </view>

    <!-- 师范生入口 -->
    <view class="card" wx:if="{{role === 'tutor'}}">
      <view class="row-between">
        <view class="card-title">师范生服务</view>
        <view class="tag tag-green">接单</view>
      </view>
      <view class="text-sub mt-8">
        完成「学籍 + 资质 + 能力」三重认证后可获得认证徽章，并在接单池按匹配度优先接单。学生零押金、平台不收取任何中介费。
      </view>
      <view class="btn btn-green mt-16" bindtap="goTutorVerify">完成三重认证</view>
      <view class="btn btn-ghost mt-16" bindtap="goTutorPool">进入接单池</view>
    </view>

    <!-- 未选择角色 -->
    <view class="card" wx:if="{{!role}}">
      <view class="empty">
        <view class="empty-icon">👆</view>
        <view class="empty-text">请先选择您的身份，平台会展示对应的功能入口</view>
      </view>
    </view>

    <!-- 演示数据说明 -->
    <view class="card">
      <view class="row-between">
        <view class="card-title">演示数据</view>
        <view class="tag {{isCloud ? 'tag-green' : 'tag-blue'}}">{{isCloud ? '云开发模式' : '本地 mock 模式'}}</view>
      </view>
      <view class="text-sub mt-8" wx:if="{{!isCloud}}">
        当前为本地 mock + storage 演示模式：需求、匹配、报告、认证记录都保存在本机，重启小程序不丢失。切换云开发请修改 utils/constants.js 的 APP_INFO.useCloud。
      </view>
      <view class="text-sub mt-8" wx:else>
        当前为微信云开发模式：数据来自云数据库，接口层已自动切换为云函数调用（详见 README）。
      </view>
      <view class="reset-row mt-16">
        <view class="btn btn-gray btn-sm" bindtap="onResetMock">重置演示数据</view>
      </view>
    </view>

    <!-- 免责声明 -->
    <view class="disclaimer">
      <view class="disclaimer-title">免责声明</view>
      <view>{{disclaimerShort}}</view>
      <view class="disclaimer-tags">
        <text class="tag tag-orange" wx:for="{{disclaimerItems}}" wx:key="*this">{{item}}</text>
      </view>
      <view class="mt-8">{{minorTip}}</view>
      <view class="mt-8">平台不参与资金往来，不提供支付 / 担保 / 结算功能（资金担保结算为二期规划）。</view>
    </view>

  </view>
  <platform-notice />
</view>
