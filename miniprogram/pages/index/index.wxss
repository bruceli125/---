/* 首页 / 角色选择 */
.index-page {
  min-height: 100vh;
  padding-bottom: 48rpx;
  box-sizing: border-box;
}

/* ---------- 品牌区（浅色 · 折射光环） ---------- */
.hero {
  position: relative;
  padding: 44rpx 36rpx 58rpx;
  background: linear-gradient(180deg, #ffffff 0%, #fafafc 100%);
  border-radius: 0 0 40rpx 40rpx;
  overflow: hidden;
}

/* 顶部虹彩晕染：整页唯一的"彩色空气" */
.hero-wash {
  position: absolute;
  left: -30%;
  right: -30%;
  top: -260rpx;
  height: 560rpx;
  background: var(--grad-prism-soft);
  filter: blur(48rpx);
  opacity: 0.9;
  pointer-events: none;
}

/* 折射光环：右侧装饰，不遮挡文字 */
.hero-ring {
  position: absolute;
  right: -72rpx;
  top: -10rpx;
  width: 282rpx;
  height: 282rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0.92;
  pointer-events: none;
}

.hero-ring .prism-halo {
  width: 360rpx;
  height: 360rpx;
}

.hero-inner {
  position: relative;
  z-index: 1;
  padding-right: 0;
}

.hero-eyebrow {
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 0.28em;
  background: var(--grad-prism);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  -webkit-text-fill-color: transparent;
}

.hero-title {
  margin-top: 16rpx;
  font-size: 46rpx;
  font-weight: 700;
  line-height: 1.14;
  letter-spacing: -0.035em;
  padding-right: 158rpx;
  color: var(--ink);
}

.hero-bar {
  width: 120rpx;
  margin: 20rpx 0 18rpx;
}

.hero-slogan {
  font-size: 27rpx;
  font-weight: 600;
  color: var(--ink-2);
}

.hero-desc {
  margin-top: 10rpx;
  font-size: 23rpx;
  line-height: 1.7;
  color: var(--ink-4);
}

.hero-tags {
  margin-top: 20rpx;
  display: flex;
  flex-wrap: wrap;
}

.hero-version {
  margin-top: 16rpx;
  font-size: 20rpx;
  letter-spacing: 0.04em;
  color: var(--ink-5);
}

/* ---------- 设计系统入口 ---------- */
.design-entry {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 18rpx;
  padding: 20rpx 24rpx;
  background: var(--paper);
  border: 1rpx solid var(--line);
  border-radius: var(--r-md);
  box-shadow: var(--sh-1);
}

.design-entry:active {
  background: var(--slate);
}

.design-entry__ring {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: conic-gradient(from 210deg, #ffb27a, #ffd166, #6fe3e1, #a78bfa, #ff9ec4, #ffb27a);
  box-shadow: 0 6rpx 16rpx -8rpx rgba(167, 139, 250, 0.8);
}

.design-entry__title {
  font-size: 25rpx;
  font-weight: 600;
  color: var(--ink);
  letter-spacing: 0.01em;
}

.design-entry__sub {
  margin-top: 2rpx;
  font-size: 21rpx;
  color: var(--ink-4);
}

.design-entry__arrow {
  font-size: 32rpx;
  color: var(--ink-5);
  line-height: 1;
}

/* ---------- 主体 ---------- */
.index-body {
  padding: 0 24rpx;
  margin-top: -32rpx;
}

.trust-item-title {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-top: 4rpx;
}

.trust-item-sub {
  font-size: 20rpx;
  color: var(--text-weak);
  margin-top: 2rpx;
}

.core-ability {
  margin-top: 16rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--brand-primary);
  background-color: var(--brand-primary-soft);
  border-radius: 999rpx;
  padding: 12rpx 20rpx;
}

/* ---------- 角色卡片 ---------- */
.role-grid {
  display: flex;
  gap: 20rpx;
}

.role-card {
  position: relative;
  flex: 1;
  background-color: #ffffff;
  border-radius: 24rpx;
  border: 3rpx solid transparent;
  box-shadow: var(--shadow-card);
  padding: 32rpx 24rpx;
  text-align: center;
  transition: all 0.15s ease;
}

.role-card-active {
  border-color: var(--brand-primary);
  background-color: var(--brand-primary-soft);
}

.role-check {
  position: absolute;
  top: 14rpx;
  right: 18rpx;
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  border-radius: 50%;
  background-color: var(--brand-primary);
  color: #ffffff;
  font-size: 24rpx;
  text-align: center;
}

.role-icon {
  font-size: 56rpx;
  line-height: 1.2;
}

.role-title {
  margin-top: 12rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-main);
}

.role-sub {
  margin-top: 4rpx;
  font-size: 26rpx;
  color: var(--brand-primary);
  font-weight: 600;
}

.role-desc {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--text-weak);
  line-height: 1.6;
}

.role-current {
  margin: 20rpx 4rpx 24rpx;
  font-size: 24rpx;
}

/* ---------- 统计 ---------- */
.stat-grid {
  display: flex;
  background-color: var(--bg-gray);
  border-radius: 16rpx;
  padding: 20rpx 0;
}

.stat-cell {
  flex: 1;
  text-align: center;
}

.stat-num {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--brand-primary);
  line-height: 1.2;
}

.stat-label {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--text-weak);
}

/* ---------- 其它 ---------- */
.report-hint {
  background-color: var(--bg-gray);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
}

.report-hint-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 6rpx;
}

.reset-row {
  display: flex;
  justify-content: flex-start;
}

.disclaimer-tags {
  margin-top: 12rpx;
  display: flex;
  flex-wrap: wrap;
}
