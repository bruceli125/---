/* 沟通列表：微信首页式的会话行 */
.chat-page {
  padding-bottom: 40rpx;
}

.chat-tip {
  margin: 40rpx 28rpx;
  padding: 28rpx;
  border-radius: var(--r-md, 18rpx);
  background: var(--paper, #fff);
  border: 1rpx solid var(--line, #e6e8ef);
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--ink-4, #8e929e);
}

.session {
  display: flex;
  align-items: flex-start;
  gap: 22rpx;
  padding: 26rpx 28rpx;
  background: var(--paper, #fff);
  border-bottom: 1rpx solid var(--line, #e6e8ef);
}

.session:active {
  background: var(--snow, #fafafc);
}

.session__avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
  background: linear-gradient(135deg, #ffb27a, #a78bfa);
}

.session__main {
  flex: 1;
  min-width: 0;
}

.session__top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.session__name {
  font-size: 29rpx;
  font-weight: 600;
  color: var(--ink, #0a0a0c);
}

.session__time {
  font-size: 20rpx;
  color: var(--ink-5, #b9bcc6);
  flex: 0 0 auto;
}

.session__demand {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--ink-3, #5c5f6b);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.session__tag {
  display: inline-block;
  margin-right: 10rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  font-size: 18rpx;
  background: var(--slate, #f2f4f8);
  color: var(--ink-4, #8e929e);
}

.session__last {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--ink-4, #8e929e);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
