<!-- 沟通列表：学生看家长，家长看学生；一行一条会话（未读在头像右上角显示数字） -->
<view class="page chat-page">

  <view class="chat-tip" wx:if="{{!loading && !list.length}}">{{emptyTip}}</view>

  <view
    class="session"
    wx:for="{{list}}"
    wx:key="threadId"
    data-demandid="{{item.demandId}}"
    data-tutorid="{{item.tutorId}}"
    data-peername="{{item.peerName}}"
    bindtap="onOpenChat"
  >
    <view class="session__avatar-wrap">
      <view class="session__avatar">{{item.peerAvatarText}}</view>
      <view class="session__badge" wx:if="{{item.unread > 0}}">{{item.unread > 99 ? '99+' : item.unread}}</view>
    </view>

    <view class="session__main">
      <view class="session__top">
        <view class="session__name-wrap">
          <!-- 需求标签：科目+年级，让家长一眼分辨是哪一单 -->
          <text class="session__demand-tag" wx:if="{{item.demandTitle}}">[{{item.demandTitle}}]</text>
          <text class="session__name">{{item.peerName}}</text>
        </view>
        <text class="session__time">{{item.lastMessageAt}}</text>
      </view>
      <view class="session__demand">
        <text class="session__tag">{{item.statusLabel}}</text>
        {{item.demandTitle}}
      </view>
      <view class="session__last">{{item.lastMessage}}</view>
    </view>
  </view>

  <view class="loading" wx:if="{{loading}}">正在加载会话…</view>

  <platform-notice />
</view>
