<!-- ChatPanel：沟通会话 + 协商确认（三期） -->
<view wx:if="{{visible}}" class="chat-mask" bindtap="onClose" catchtouchmove="noop">
  <view class="chat-sheet" catchtap="noop">

    <!-- 头部：对方 + 协商状态 -->
    <view class="chat-head">
      <view class="chat-head__main">
        <view class="chat-head__title">{{peerName}}</view>
        <view class="chat-head__sub">{{demandTitle}}</view>
      </view>
      <view class="chat-head__status chat-head__status--{{negotiation.status}}">
        {{negotiation.statusLabel}}
      </view>
      <view class="chat-head__close" bindtap="onClose">✕</view>
    </view>

    <!-- 协商完成区：双方确认状态 + 确认按钮 -->
    <view class="nego">
      <view class="nego__row">
        <view class="nego__who">
          <text class="nego__dot {{negotiation.studentConfirmed ? 'nego__dot--on' : ''}}"></text>
          <text class="nego__label">学生确认接单</text>
          <text class="nego__state">{{negotiation.studentConfirmed ? '已确认' : '待确认'}}</text>
        </view>
        <view class="nego__who">
          <text class="nego__dot {{negotiation.parentConfirmed ? 'nego__dot--on' : ''}}"></text>
          <text class="nego__label">家长同意雇佣</text>
          <text class="nego__state">{{negotiation.parentConfirmed ? '已同意' : '待确认'}}</text>
        </view>
      </view>

      <view wx:if="{{negotiation.bothConfirmed}}" class="nego__done">
        ✅ 双方已达成共识，正式匹配成功！
      </view>
      <view wx:else class="nego__tip">{{negotiation.tip}}</view>

      <view
        wx:if="{{!negotiation.bothConfirmed}}"
        class="nego__btn {{(role === 'parent' ? negotiation.parentConfirmed : negotiation.studentConfirmed) ? 'nego__btn--wait' : ''}}"
        bindtap="onConfirm"
      >
        {{role === 'parent'
          ? (negotiation.parentConfirmed ? '已同意，等待学生确认' : '同意雇佣')
          : (negotiation.studentConfirmed ? '已确认，等待家长同意' : '确认接单')}}
      </view>
    </view>

    <!-- 消息列表 -->
    <scroll-view class="chat-body" scroll-y scroll-top="{{scrollTop}}" scroll-with-animation>
      <view wx:if="{{loading}}" class="chat-empty">会话加载中…</view>
      <view wx:elif="{{!messages.length}}" class="chat-empty">还没有消息，先打个招呼吧</view>

      <block wx:for="{{messages}}" wx:key="id">
        <!-- 系统消息居中 -->
        <view wx:if="{{item.isSystem}}" class="chat-sys">{{item.text}}</view>

        <!-- 普通气泡 -->
        <view wx:else class="chat-row {{item.mine ? 'chat-row--mine' : ''}}">
          <view class="chat-bubble {{item.mine ? 'chat-bubble--mine' : ''}}">
            <text class="chat-text">{{item.text}}</text>
            <view wx:if="{{item.auto}}" class="chat-auto">自动生成</view>
          </view>
        </view>
        <view class="chat-time {{item.mine ? 'chat-time--mine' : ''}}">{{item.createdAt}}</view>
      </block>
    </scroll-view>

    <!-- 输入区 -->
    <view class="chat-input-bar">
      <input
        class="chat-input"
        value="{{draft}}"
        maxlength="{{maxLen}}"
        placeholder="说说课时、时间或孩子的情况…"
        confirm-type="send"
        bindinput="onInput"
        bindconfirm="send"
      />
      <view class="chat-send {{sending ? 'chat-send--off' : ''}}" bindtap="send">{{sending ? '发送中' : '发送'}}</view>
    </view>

    <view class="chat-safety">{{safetyTip}}</view>
  </view>
</view>
