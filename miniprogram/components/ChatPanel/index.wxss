/* ChatPanel —— 沟通面板（底部弹层）
   设计语言沿用 LIGHTCORE PRISM：白面 + 细边框 + 虹彩点缀，只在这里用一次渐变表示"达成共识" */
.chat-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(10, 10, 12, 0.42);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

.chat-sheet {
  width: 100%;
  max-height: 86vh;
  display: flex;
  flex-direction: column;
  background: var(--paper, #fff);
  border-radius: 32rpx 32rpx 0 0;
  padding-bottom: env(safe-area-inset-bottom);
  box-shadow: 0 -20rpx 60rpx -24rpx rgba(10, 10, 12, 0.4);
}

/* ---------- 头部 ---------- */
.chat-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 26rpx 28rpx 18rpx;
  border-bottom: 1rpx solid var(--line, #e6e8ef);
}

.chat-head__main {
  flex: 1;
  min-width: 0;
}

.chat-head__title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink, #0a0a0c);
}

.chat-head__sub {
  margin-top: 2rpx;
  font-size: 21rpx;
  color: var(--ink-4, #8e929e);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.chat-head__status {
  font-size: 20rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: var(--slate, #f2f4f8);
  color: var(--ink-3, #5c5f6b);
  flex-shrink: 0;
}

.chat-head__status--communicating {
  background: var(--violet-soft, #f1edff);
  color: var(--violet, #6d4aff);
}

.chat-head__status--matched {
  background: var(--ok-soft, #e6f7f1);
  color: var(--ok, #0e9f6e);
}

.chat-head__close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: var(--ink-4, #8e929e);
  flex-shrink: 0;
}

/* ---------- 协商完成区 ---------- */
.nego {
  margin: 18rpx 24rpx 0;
  padding: 20rpx;
  border-radius: var(--r-md, 18rpx);
  border: 1rpx solid var(--line, #e6e8ef);
  background: var(--snow, #fafafc);
}

.nego__row {
  display: flex;
  gap: 16rpx;
}

.nego__who {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.nego__dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--line-2, #d8dbe4);
  flex-shrink: 0;
}

.nego__dot--on {
  background: var(--ok, #0e9f6e);
}

.nego__label {
  font-size: 21rpx;
  color: var(--ink-3, #5c5f6b);
}

.nego__state {
  font-size: 20rpx;
  color: var(--ink-4, #8e929e);
}

.nego__tip {
  margin-top: 12rpx;
  font-size: 21rpx;
  color: var(--ink-4, #8e929e);
  line-height: 1.6;
}

.nego__done {
  margin-top: 12rpx;
  padding: 14rpx 16rpx;
  border-radius: var(--r-sm, 12rpx);
  font-size: 23rpx;
  font-weight: 600;
  color: var(--ink, #0a0a0c);
  background: var(--grad-prism-soft, linear-gradient(120deg, #fff3e8, #f3efff));
  border: 1rpx solid rgba(167, 139, 250, 0.28);
}

.nego__btn {
  margin-top: 16rpx;
  height: 76rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--ink, #0a0a0c);
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
}

.nego__btn--wait {
  background: var(--slate, #f2f4f8);
  color: var(--ink-4, #8e929e);
}

/* ---------- 消息区 ---------- */
.chat-body {
  flex: 1;
  min-height: 380rpx;
  max-height: 46vh;
  padding: 20rpx 24rpx 0;
  box-sizing: border-box;
}

.chat-empty {
  padding: 80rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: var(--ink-5, #b9bcc6);
}

.chat-sys {
  margin: 14rpx auto;
  max-width: 84%;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  line-height: 1.6;
  text-align: center;
  color: var(--ink-4, #8e929e);
  background: var(--slate, #f2f4f8);
}

.chat-row {
  display: flex;
  margin-top: 18rpx;
}

.chat-row--mine {
  justify-content: flex-end;
}

.chat-bubble {
  max-width: 78%;
  padding: 18rpx 22rpx;
  border-radius: 22rpx 22rpx 22rpx 6rpx;
  background: var(--paper, #fff);
  border: 1rpx solid var(--line, #e6e8ef);
  position: relative;
}

.chat-bubble--mine {
  border-radius: 22rpx 22rpx 6rpx 22rpx;
  background: var(--ink, #0a0a0c);
  border-color: var(--ink, #0a0a0c);
}

.chat-text {
  font-size: 26rpx;
  line-height: 1.65;
  color: var(--ink, #0a0a0c);
  word-break: break-all;
}

.chat-bubble--mine .chat-text {
  color: #fff;
}

.chat-auto {
  margin-top: 8rpx;
  font-size: 18rpx;
  color: var(--ink-4, #8e929e);
}

.chat-bubble--mine .chat-auto {
  color: rgba(255, 255, 255, 0.6);
}

.chat-time {
  margin: 6rpx 0 0 6rpx;
  font-size: 18rpx;
  color: var(--ink-5, #b9bcc6);
}

.chat-time--mine {
  text-align: right;
  margin-right: 6rpx;
}

/* ---------- 输入区 ---------- */
.chat-input-bar {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 16rpx 24rpx 10rpx;
  border-top: 1rpx solid var(--line, #e6e8ef);
}

.chat-input {
  flex: 1;
  min-width: 0;
  height: 76rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: var(--slate, #f2f4f8);
  font-size: 26rpx;
  color: var(--ink, #0a0a0c);
}

.chat-send {
  flex-shrink: 0;
  height: 76rpx;
  padding: 0 32rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--ink, #0a0a0c);
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
}

.chat-send--off {
  opacity: 0.5;
}

.chat-safety {
  padding: 6rpx 24rpx 14rpx;
  font-size: 19rpx;
  line-height: 1.6;
  color: var(--ink-5, #b9bcc6);
  text-align: center;
}
