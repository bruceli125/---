/* HoldButton —— 长按环形确认按钮
   防抖动三要素：① 宽度固定 ② 无 scale 变换 ③ 环无 transition（渐变色不可插值） */
.hb {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  /* 固定宽度：文案切换不再撑动整行，这是"屏幕不抖"的第一要素 */
  width: 208rpx;
  height: 72rpx;
  padding: 0 18rpx 0 8rpx;
  box-sizing: border-box;
  flex: 0 0 auto;
  border-radius: 999rpx;
  border: 1rpx solid var(--line-2, #d8dbe4);
  background: #ffffff;
  transition: border-color 180ms ease, background-color 180ms ease;
}

.hb--holding {
  border-color: var(--ink, #0a0a0c);
}

.hb--done {
  background: var(--ink, #0a0a0c);
  border-color: var(--ink, #0a0a0c);
}

.hb--off {
  opacity: 0.45;
}

/* 环形进度：外圈 conic-gradient 由 JS 写入，内圈白色留出"环" */
.hb__ringwrap {
  position: relative;
  width: 46rpx;
  height: 46rpx;
  flex: 0 0 auto;
}

.hb__ring {
  width: 46rpx;
  height: 46rpx;
  border-radius: 50%;
}

.hb__hole {
  position: absolute;
  top: 7rpx;
  right: 7rpx;
  bottom: 7rpx;
  left: 7rpx;
  border-radius: 50%;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.hb--done .hb__hole {
  background: var(--ink, #0a0a0c);
}

.hb__check {
  font-size: 22rpx;
  line-height: 1;
  font-weight: 700;
  color: #ffffff;
}

.hb__text {
  font-size: 25rpx;
  font-weight: 600;
  letter-spacing: 0.01em;
  color: var(--ink, #0a0a0c);
  white-space: nowrap;
}

.hb--done .hb__text {
  color: #ffffff;
}
