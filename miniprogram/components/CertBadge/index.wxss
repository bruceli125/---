/* CertBadge 认证徽章：蓝色 = 认证中/部分认证，绿色 = 三重认证，灰色 = 未认证 */

/* ---------- 形态二：胶囊徽章 ---------- */
.badge {
  display: flex;
  align-items: center;
  border-radius: 999rpx;
  border: 2rpx solid transparent;
  line-height: 1.3;
}

.badge-icon {
  margin-right: 8rpx;
  font-size: 22rpx;
}

.badge-main {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  min-width: 0;
}

.badge-label {
  font-weight: 600;
  white-space: nowrap;
}

.badge-no {
  font-size: 18rpx;
  opacity: 0.8;
  letter-spacing: 0.5rpx;
}

/* 等级配色 */
.badge-gray {
  background-color: var(--bg-gray, #f2f4f7);
  color: var(--text-weak, #98a2b3);
  border-color: #e4e7ec;
}

.badge-blue {
  background-color: var(--brand-primary-soft, #eaf1ff);
  color: var(--brand-primary, #1f4fbf);
  border-color: #c7d9ff;
}

.badge-deep {
  background-color: #e3ebff;
  color: #1a3f99;
  border-color: #a9c2ff;
}

.badge-green {
  background: linear-gradient(135deg, #22c77a, var(--trust-green, #17b26a));
  color: #ffffff;
  border-color: #0f9c5c;
  box-shadow: 0 6rpx 16rpx rgba(23, 178, 106, 0.28);
}

/* 尺寸 */
.size-sm {
  padding: 4rpx 14rpx;
  font-size: 20rpx;
}

.size-md {
  padding: 6rpx 18rpx;
  font-size: 22rpx;
}

.size-lg {
  padding: 10rpx 24rpx;
  font-size: 26rpx;
}

.size-sm .badge-icon {
  font-size: 20rpx;
  margin-right: 6rpx;
}

.size-lg .badge-icon {
  font-size: 28rpx;
  margin-right: 10rpx;
}

.is-clickable {
  transition: transform 0.15s ease;
}

.is-clickable:active {
  transform: scale(0.97);
}

/* ---------- 形态一：完整认证卡片 ---------- */
.cert-card {
  position: relative;
  display: flex;
  padding: 28rpx;
  border-radius: var(--radius-lg, 24rpx);
  background: linear-gradient(135deg, #ffffff 0%, #f4f8ff 100%);
  border: 2rpx solid #d9e6ff;
  box-shadow: 0 8rpx 28rpx rgba(31, 79, 191, 0.1);
  overflow: hidden;
}

/* 左侧彩条，强化“可信”观感 */
.cert-card::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 8rpx;
}

.cert-green {
  border-color: #b7efd3;
  background: linear-gradient(135deg, #ffffff 0%, #f1fdf7 100%);
  box-shadow: 0 8rpx 28rpx rgba(23, 178, 106, 0.14);
}

.cert-gray {
  border-color: #e4e7ec;
  background: linear-gradient(135deg, #ffffff 0%, #f7f8fa 100%);
  box-shadow: 0 8rpx 24rpx rgba(16, 24, 40, 0.06);
}

.cert-blue::before,
.cert-deep::before {
  background: linear-gradient(180deg, var(--brand-primary-light, #2b6de5), var(--brand-primary, #1f4fbf));
}

.cert-green::before {
  background: linear-gradient(180deg, #22c77a, var(--trust-green, #17b26a));
}

.cert-gray::before {
  background: #d0d5dd;
}

.cc-left {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 150rpx;
  flex-shrink: 0;
  margin-right: 24rpx;
}

.cc-shield {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #eaf1ff, #d6e4ff);
  border: 4rpx solid #ffffff;
  box-shadow: 0 6rpx 18rpx rgba(31, 79, 191, 0.18);
}

.cert-green .cc-shield {
  background: linear-gradient(135deg, #e7f8f0, #c6f0dd);
  box-shadow: 0 6rpx 18rpx rgba(23, 178, 106, 0.22);
}

.cert-gray .cc-shield {
  background: linear-gradient(135deg, #f2f4f7, #e4e7ec);
  box-shadow: none;
}

.cc-shield-icon {
  font-size: 52rpx;
  line-height: 1;
}

.cc-level-tag {
  margin-top: 14rpx;
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background-color: var(--brand-primary, #1f4fbf);
  color: #ffffff;
  white-space: nowrap;
}

.cert-green .cc-level-tag {
  background-color: var(--trust-green, #17b26a);
}

.cert-gray .cc-level-tag {
  background-color: #98a2b3;
}

.cc-right {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.cc-name-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.cc-name {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-main, #1d2939);
  margin-right: 14rpx;
}

.cc-verified-flag {
  font-size: 20rpx;
  color: var(--trust-green, #17b26a);
  background-color: var(--trust-green-soft, #e7f8f0);
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
}

.cc-school {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--text-sub, #475467);
}

.cc-desc {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--text-weak, #98a2b3);
}

.cc-no-row {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  background-color: #ffffff;
  border: 2rpx dashed #c7d9ff;
  border-radius: var(--radius-sm, 8rpx);
  padding: 10rpx 16rpx;
  align-self: flex-start;
  max-width: 100%;
}

.cc-no-label {
  font-size: 20rpx;
  color: var(--text-weak, #98a2b3);
  margin-right: 10rpx;
  flex-shrink: 0;
}

.cc-no-value {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--brand-primary, #1f4fbf);
  letter-spacing: 1rpx;
  font-family: Menlo, Consolas, monospace;
}

.cc-no-copy {
  font-size: 20rpx;
  color: #ffffff;
  background-color: var(--brand-primary-light, #2b6de5);
  border-radius: 999rpx;
  padding: 2rpx 14rpx;
  margin-left: 14rpx;
  flex-shrink: 0;
}

.cc-tags {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
}

.cc-tag {
  font-size: 20rpx;
  color: var(--trust-green, #17b26a);
  background-color: var(--trust-green-soft, #e7f8f0);
  border-radius: 999rpx;
  padding: 4rpx 14rpx;
  margin: 0 12rpx 8rpx 0;
}

.cc-foot {
  margin-top: 12rpx;
  font-size: 20rpx;
  color: var(--text-weak, #98a2b3);
}

/* lg 尺寸：放大盾牌与姓名，用于详情页 / 报告页 */
.cert-card.size-lg {
  padding: 34rpx;
}

.size-lg .cc-shield {
  width: 124rpx;
  height: 124rpx;
}

.size-lg .cc-shield-icon {
  font-size: 62rpx;
}

.size-lg .cc-name {
  font-size: 40rpx;
}

/* 注意：这里必须限定 .cert-card，否则会覆盖胶囊形态的 .size-sm 内边距 */
.cert-card.size-sm {
  padding: 18rpx;
}

.size-sm .cc-left {
  width: 110rpx;
  margin-right: 16rpx;
}

.size-sm .cc-shield {
  width: 76rpx;
  height: 76rpx;
}

.size-sm .cc-shield-icon {
  font-size: 36rpx;
}

.size-sm .cc-name {
  font-size: 30rpx;
}

.size-sm .cc-desc,
.size-sm .cc-foot {
  display: none;
}
