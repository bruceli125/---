/**
 * CheckinCard 样式（组件样式隔离，不依赖 app.wxss 的类；
 * 但 CSS 自定义属性会继承进来，所以主题色统一用 var(--x, 兜底值)）
 */
.cc {
  background-color: #ffffff;
  border-radius: var(--radius-lg, 24rpx);
  padding: 26rpx 28rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-card, 0 4rpx 20rpx rgba(16, 24, 40, 0.06));
  border: 2rpx solid var(--border-color, #EAECF0);
}

.cc-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.cc-date-wrap {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.cc-date {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main, #1D2939);
}

.cc-time {
  font-size: 24rpx;
  color: var(--text-weak, #98A2B3);
  margin-top: 4rpx;
}

.cc-badge {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 1.7;
}

.cc-meta {
  margin-top: 12rpx;
}

.cc-dur {
  font-size: 24rpx;
  color: var(--brand-primary, #1F4FBF);
  font-weight: 600;
}

.cc-dur-empty {
  color: var(--text-weak, #98A2B3);
  font-weight: 400;
}

.cc-loc {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-top: 14rpx;
}

.cc-loc-icon {
  font-size: 22rpx;
  margin-right: 6rpx;
}

.cc-loc-name {
  font-size: 24rpx;
  color: var(--text-sub, #475467);
  margin-right: 10rpx;
}

.cc-mock {
  font-size: 20rpx;
  color: var(--warn-orange, #F79009);
  background-color: var(--warn-orange-soft, #FFF4E5);
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
}

.cc-addr {
  font-size: 22rpx;
  color: var(--text-weak, #98A2B3);
  margin-top: 6rpx;
  margin-left: 30rpx;
  word-break: break-all;
}

.cc-summary {
  margin-top: 18rpx;
  background-color: var(--bg-gray, #F2F4F7);
  border-radius: var(--radius-md, 16rpx);
  padding: 18rpx 20rpx;
}

.cc-summary-title {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-sub, #475467);
  margin-bottom: 8rpx;
}

.cc-summary-text {
  font-size: 25rpx;
  color: var(--text-main, #1D2939);
  line-height: 1.7;
  white-space: pre-wrap;
  word-break: break-all;
}

.cc-summary-empty {
  margin-top: 16rpx;
  font-size: 23rpx;
  color: var(--text-weak, #98A2B3);
}

.cc-confirm {
  margin-top: 16rpx;
  font-size: 23rpx;
  color: var(--text-weak, #98A2B3);
  padding-top: 14rpx;
  border-top: 2rpx solid var(--border-color, #EAECF0);
}

.cc-actions {
  margin-top: 18rpx;
}

.cc-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 76rpx;
  border-radius: 999rpx;
  font-size: 27rpx;
  font-weight: 600;
}

.cc-btn-confirm {
  background: linear-gradient(135deg, #22C77A, var(--trust-green, #17B26A));
  color: #ffffff;
  box-shadow: 0 8rpx 18rpx rgba(23, 178, 106, 0.22);
}

.cc-btn-finish {
  background: linear-gradient(135deg, var(--brand-primary-light, #2B6DE5), var(--brand-primary, #1F4FBF));
  color: #ffffff;
  box-shadow: 0 8rpx 18rpx rgba(31, 79, 191, 0.22);
}
