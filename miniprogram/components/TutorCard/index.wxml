<!-- TutorCard：师范生卡片。整卡 bindtap，底部申请按钮用 catchtap 阻止冒泡 -->
<view class="tutor-card" bindtap="onTap">

  <!-- 头部：头像 + 姓名 / 认证徽章 / 学校专业年级 / 标签 -->
  <view class="tc-head">
    <view class="tc-avatar">
      <image
        wx:if="{{useImage}}"
        class="tc-avatar-img"
        src="{{tutor.avatar}}"
        mode="aspectFill"
        binderror="onAvatarError"
      />
      <view wx:else class="tc-avatar-text">{{avatarText}}</view>
    </view>

    <view class="tc-head-main">
      <view class="tc-name-row">
        <text class="tc-name">{{nameText}}</text>
        <view wx:if="{{rankText}}" class="tc-rank {{rankClass}}">{{rankText}}</view>
        <cert-badge
          wx:if="{{showCertBadge}}"
          level="{{certLevel}}"
          badge-no="{{certBadgeNo}}"
          size="sm"
        />
      </view>

      <view class="tc-school ellipsis">{{schoolLine || '首都师范大学'}}</view>

      <view class="tc-tags" wx:if="{{tagList.length}}">
        <text
          class="tc-tag tc-tag-{{item.type}}"
          wx:for="{{tagList}}"
          wx:key="text"
        >{{item.text}}</text>
      </view>
    </view>
  </view>

  <!-- 数据行：课时费 / 信用分 / 距离 / 评分 / 接单数 -->
  <view class="tc-stats">
    <view class="tc-stat">
      <text class="tc-stat-value tc-price">{{priceText}}</text>
      <text class="tc-stat-label">课时费</text>
    </view>
    <view class="tc-stat-split"></view>
    <view class="tc-stat">
      <text class="tc-stat-value">{{creditText}}</text>
      <text class="tc-stat-label">信用分</text>
    </view>
    <view class="tc-stat-split"></view>
    <view class="tc-stat">
      <text class="tc-stat-value">{{distanceText}}</text>
      <text class="tc-stat-label">距离</text>
    </view>
    <view class="tc-stat-split"></view>
    <view class="tc-stat">
      <text class="tc-stat-value">{{ratingText}}<text class="tc-star"> ★</text></text>
      <text class="tc-stat-label">评分 · {{orderText}}</text>
    </view>
  </view>

  <!-- 简介 -->
  <view class="tc-intro ellipsis-2" wx:if="{{introText}}">{{introText}}</view>

  <!-- 匹配度进度条 -->
  <view class="tc-score" wx:if="{{hasScore}}">
    <view class="tc-score-bar">
      <view class="tc-score-fill" style="width: {{scorePercent}}%;"></view>
    </view>
    <text class="tc-score-text">{{scoreText}}</text>
  </view>

  <!-- 推荐理由 -->
  <view class="tc-reasons" wx:if="{{reasonList.length}}">
    <view class="tc-reasons-title">推荐理由</view>
    <view class="tc-reason" wx:for="{{reasonList}}" wx:key="*this">
      <text class="tc-reason-dot">·</text>
      <text class="tc-reason-text">{{item}}</text>
    </view>
  </view>

  <!-- 底部操作 -->
  <view class="tc-footer" wx:if="{{showApply}}">
    <view class="tc-hint">平台不收押金 · 试课不满意可换</view>
    <view class="tc-actions">
      <text wx:if="{{applied}}" class="tc-cancel" catchtap="onCancel">取消接单</text>
      <!-- 长按确认接单：按住环形进度增长，松手完成；中途松手取消复位 -->
      <hold-button
        label="{{applyBtnText}}"
        done="{{applied}}"
        disabled="{{applyDisabled && !applied}}"
        duration="{{1200}}"
        bind:confirm="onApply"
      />
    </view>
  </view>

</view>
