/* DemandCard 需求卡片（二期升级版） */

.demand-card {
  position: relative;
  overflow: hidden; /* 让右上角角标的直角边跟随卡片圆角裁切 */
  background-color: var(--bg-card, #ffffff);
  border-radius: var(--radius-lg, 24rpx);
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-card, 0 4rpx 20rpx rgba(16, 24, 40, 0.06));
  border: 2rpx solid var(--border-color, #eaecf0);
}

.demand-card:active {
  background-color: #fbfcfe;
}

/* ---------- 右上角状态角标 ---------- */
.dc-corner {
  position: absolute;
  top: 0;
  right: 0;
  z-index: 2;
  min-width: 120rpx;
  padding: 8rpx 22rpx 10rpx;
  text-align: center;
  border-radius: 0 var(--radius-lg, 24rpx) 0 var(--radius-md, 16rpx);
  font-size: 22rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 1rpx;
}

/* 招募中=绿 / 匹配中=蓝 / 已匹配=紫 / 已结束=灰 / 风险拦截=红 */
.cn-green {
  background: linear-gradient(135deg, #22c77a, #17b26a);
}

.cn-blue {
  background: linear-gradient(135deg, #4f86f7, #1f4fbf);
}

.cn-purple {
  background: linear-gradient(135deg, #8b6bf0, #5b34e0);
}

.cn-gray {
  background: linear-gradient(135deg, #b4bdc9, #98a2b3);
}

.cn-red {
  background: linear-gradient(135deg, #f97066, #f04438);
}

/* ---------- 标题行（右侧留白给角标，避免遮挡） ---------- */
.dc-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding-right: 160rpx;
}

.dc-title-row {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
}

.dc-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-main, #1d2939);
  margin-right: 14rpx;
}

.dc-distance {
  font-size: 22rpx;
  color: var(--text-weak, #98a2b3);
}

/* ---------- 学科类标记 / 打卡徽章 ---------- */
.dc-badge-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-top: 14rpx;
}

.dc-group {
  font-size: 20rpx;
  font-weight: 600;
  border-radius: 6rpx;
  padding: 3rpx 12rpx;
  margin-right: 12rpx;
}

/* 学科类：灰色（提示受双减约束） */
.dc-group-discipline {
  background-color: var(--bg-gray, #f2f4f7);
  color: var(--text-sub, #475467);
  border: 2rpx solid #e4e7ec;
}

/* 素质拓展：绿色（不受休息日限制） */
.dc-group-quality {
  background-color: var(--trust-green-soft, #e7f8f0);
  color: var(--trust-green, #17b26a);
  border: 2rpx solid #bfeeda;
}

.dc-checkin {
  font-size: 20rpx;
  font-weight: 600;
  color: var(--trust-green, #17b26a);
  background-color: var(--trust-green-soft, #e7f8f0);
  border-radius: 999rpx;
  padding: 3rpx 14rpx;
  margin-right: 12rpx;
}

/* ---------- 已成单 / 订单进度提示 ---------- */
.dc-matched {
  margin-top: 14rpx;
  background-color: var(--trust-green-soft, #e7f8f0);
  border: 2rpx solid #bfeeda;
  border-radius: 12rpx;
  padding: 12rpx 18rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #067647;
}

.dc-hint {
  margin-top: 14rpx;
  background-color: var(--brand-primary-soft, #eaf1ff);
  border-radius: 12rpx;
  padding: 12rpx 18rpx;
  font-size: 23rpx;
  color: var(--brand-primary, #1f4fbf);
}

/* ---------- 风险标签 ---------- */
.dc-risk {
  margin-top: 18rpx;
  border-radius: 12rpx;
  padding: 14rpx 18rpx;
}

.risk-high {
  background-color: var(--danger-red-soft, #feeceb);
  border: 2rpx solid #fbc9c4;
}

.risk-medium {
  background-color: var(--warn-orange-soft, #fff4e5);
  border: 2rpx solid #fcd9a8;
}

.dc-risk-text {
  font-size: 24rpx;
  font-weight: 700;
}

.risk-high .dc-risk-text {
  color: var(--danger-red, #f04438);
}

.risk-medium .dc-risk-text {
  color: #b54708;
}

.dc-risk-words {
  margin-top: 10rpx;
  display: flex;
  flex-wrap: wrap;
}

.dc-risk-word {
  font-size: 20rpx;
  color: var(--danger-red, #f04438);
  background-color: #ffffff;
  border: 2rpx solid #fbc9c4;
  border-radius: 999rpx;
  padding: 2rpx 14rpx;
  margin: 0 10rpx 6rpx 0;
}

.risk-medium .dc-risk-word {
  color: #b54708;
  border-color: #fcd9a8;
}

/* ---------- 标签行（频次 / 时间段 / 方式 / 区域 / 薪资） ---------- */
.dc-tags {
  margin-top: 18rpx;
  display: flex;
  flex-wrap: wrap;
}

.dc-tag {
  display: flex;
  align-items: center;
  background-color: var(--bg-gray, #f2f4f7);
  border-radius: 999rpx;
  padding: 6rpx 16rpx;
  margin: 0 12rpx 10rpx 0;
  border: 2rpx solid transparent;
}

.dc-tag-icon {
  font-size: 20rpx;
  margin-right: 6rpx;
}

.dc-tag-text {
  font-size: 22rpx;
  color: var(--text-sub, #475467);
}

/* 薪资：橙色加粗，视觉上明显区别于其它四项 */
.dc-tag-salary {
  background-color: var(--warn-orange-soft, #fff4e5);
  border-color: #fcd9a8;
}

.dc-tag-salary .dc-tag-text {
  color: #d9480f;
  font-weight: 700;
  font-size: 23rpx;
}

/* ---------- 地址 / 特殊要求 ---------- */
.dc-address {
  margin-top: 6rpx;
  display: flex;
  align-items: center;
}

.dc-address-icon {
  font-size: 22rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
}

.dc-address-text {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  color: var(--text-sub, #475467);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 组件样式隔离，app.wxss 的 .ellipsis-2 在组件内不生效，这里自带两行截断 */
.dc-special {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: var(--text-weak, #98a2b3);
  line-height: 1.6;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* ---------- 匹配度 ---------- */
.dc-score-row {
  margin-top: 18rpx;
  background-color: #f4f8ff;
  border-radius: 14rpx;
  padding: 16rpx 20rpx;
}

.dc-score-text {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--brand-primary, #1f4fbf);
}

.dc-reasons {
  margin-top: 10rpx;
  display: flex;
  flex-wrap: wrap;
}

.dc-reason {
  font-size: 22rpx;
  color: var(--text-sub, #475467);
  background-color: #ffffff;
  border-radius: 999rpx;
  padding: 4rpx 14rpx;
  margin: 0 12rpx 8rpx 0;
}

/* ---------- 底部 ---------- */
.dc-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 2rpx solid var(--border-color, #eaecf0);
}

.dc-foot-left {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.dc-time {
  font-size: 22rpx;
  color: var(--text-weak, #98a2b3);
}

.dc-meta {
  font-size: 21rpx;
  color: var(--text-weak, #98a2b3);
  margin-top: 4rpx;
}

.dc-apply {
  flex-shrink: 0;
  height: 68rpx;
  padding: 0 34rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
  color: #ffffff;
  background: linear-gradient(135deg, #22c77a, #17b26a);
  box-shadow: 0 6rpx 16rpx rgba(23, 178, 106, 0.24);
}

.dc-apply:active {
  opacity: 0.86;
}

.dc-apply-disabled {
  background: #d0d5dd;
  box-shadow: none;
}
