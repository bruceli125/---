/* RiskAlert 风险提示弹层：红色 = 高风险，橙色 = 中风险，绿色 = 通过 */

.ra-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  background-color: rgba(16, 24, 40, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
}

.ra-dialog {
  position: relative;
  width: 100%;
  max-width: 640rpx;
  max-height: 82vh;
  background-color: #ffffff;
  border-radius: 28rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  box-shadow: 0 24rpx 60rpx rgba(16, 24, 40, 0.28);
  animation: ra-in 0.18s ease-out;
}

@keyframes ra-in {
  from {
    opacity: 0;
    transform: scale(0.92) translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: scale(1) translateY(0);
  }
}

.ra-bar {
  height: 10rpx;
  width: 100%;
}

.ra-head {
  padding: 28rpx 32rpx 20rpx;
}

.ra-chip {
  display: inline-block;
  font-size: 22rpx;
  font-weight: 600;
  padding: 4rpx 18rpx;
  border-radius: 999rpx;
}

.ra-title {
  margin-top: 16rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-main, #1d2939);
  line-height: 1.4;
}

.ra-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--text-sub, #475467);
  line-height: 1.6;
}

.ra-body {
  flex: 1;
  min-height: 120rpx;
  /* scroll-view 必须有确定高度才能稳定滚动，这里取屏高的 48%，并让弹层整体不超过 82vh */
  height: 48vh;
  max-height: 48vh;
  padding: 0 32rpx;
  box-sizing: border-box;
}

/* 内容较少时自适应高度，避免大片空白 */
.ra-body-auto {
  height: auto;
  max-height: 48vh;
}

.ra-sec-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-main, #1d2939);
  margin-bottom: 14rpx;
}

.ra-sec-title-gap {
  margin-top: 28rpx;
}

.ra-sec-count {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--text-weak, #98a2b3);
}

.ra-empty {
  font-size: 24rpx;
  color: var(--text-weak, #98a2b3);
  background-color: var(--bg-gray, #f2f4f7);
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  line-height: 1.6;
}

.ra-hit {
  background-color: #fffbf5;
  border: 2rpx solid #ffe4bd;
  border-radius: 14rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 14rpx;
}

.ra-hit-head {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.ra-hit-word {
  font-size: 26rpx;
  font-weight: 700;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  margin-right: 14rpx;
}

.ra-hit-cat {
  font-size: 22rpx;
  color: var(--text-weak, #98a2b3);
}

.ra-hit-tip {
  font-size: 24rpx;
  color: var(--text-sub, #475467);
  line-height: 1.6;
}

.ra-tip {
  display: flex;
  align-items: flex-start;
  margin-bottom: 14rpx;
}

.ra-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background-color: var(--warn-orange, #f79009);
  margin: 12rpx 14rpx 0 0;
  flex-shrink: 0;
}

.ra-tip-text {
  flex: 1;
  font-size: 24rpx;
  color: var(--text-sub, #475467);
  line-height: 1.65;
}

.ra-more {
  font-size: 22rpx;
  color: var(--text-weak, #98a2b3);
  padding: 6rpx 0 0 26rpx;
}

.ra-safe-tip {
  margin: 24rpx 0 28rpx;
  font-size: 22rpx;
  color: #b54708;
  background-color: var(--danger-red-soft, #feeceb);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  line-height: 1.6;
}

.ra-footer {
  display: flex;
  padding: 20rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  border-top: 2rpx solid var(--border-color, #eaecf0);
  gap: 20rpx;
  background-color: #ffffff;
}

.ra-btn {
  flex: 1;
  height: 84rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
}

.ra-btn-cancel {
  background-color: var(--bg-gray, #f2f4f7);
  color: var(--text-sub, #475467);
}

.ra-btn-confirm {
  color: #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(240, 68, 56, 0.2);
}

.ra-btn:active {
  opacity: 0.86;
}
