/**
 * ReviewTags 样式（组件样式隔离；主题色用 CSS 变量 + 兜底值）
 */
.rt {
  display: flex;
  flex-wrap: wrap;
}

.rt-item {
  display: flex;
  align-items: center;
  padding: 12rpx 26rpx;
  margin: 0 16rpx 16rpx 0;
  border-radius: 999rpx;
  font-size: 25rpx;
  background-color: var(--bg-gray, #f2f4f8);
  color: var(--text-sub, #5c5f6b);
  border: 2rpx solid transparent;
  transition: all 0.15s ease;
}

.rt-label {
  line-height: 1.4;
}

.rt-check {
  margin-left: 8rpx;
  font-size: 22rpx;
  font-weight: 700;
}

/* 选中态：绿色（老师侧） */
.rt-active.rt-green {
  background-color: var(--trust-green-soft, #e6f7f1);
  color: var(--trust-green, #0e9f6e);
  border-color: var(--trust-green, #0e9f6e);
  font-weight: 600;
}

/* 选中态：蓝色（家长侧） */
.rt-active.rt-blue {
  background-color: var(--brand-primary-soft, #f1edff);
  color: var(--brand-primary, #0a0a0c);
  border-color: var(--brand-primary, #0a0a0c);
  font-weight: 600;
}

/* 只读：不可点击的观感，但保持选中态可见 */
.rt-readonly {
  opacity: 0.95;
}

.rt-readonly.rt-active {
  box-shadow: none;
}

.rt-empty {
  font-size: 23rpx;
  color: var(--text-weak, #8e929e);
  padding: 8rpx 0;
}
