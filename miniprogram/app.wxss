/**
 * 京师家教可信对接平台 —— 全局样式
 * 设计语言：教育蓝（可信、专业）+ 可信绿（认证、通过）+ 警示橙/红（风险）
 * 所有颜色统一走 CSS 变量，便于二期整体换肤。
 */
page {
  /* 主色：教育蓝 */
  --brand-primary: #1F4FBF;
  --brand-primary-light: #2B6DE5;
  --brand-primary-soft: #EAF1FF;

  /* 辅助色：可信绿 */
  --trust-green: #17B26A;
  --trust-green-soft: #E7F8F0;

  /* 警示色 */
  --warn-orange: #F79009;
  --warn-orange-soft: #FFF4E5;
  --danger-red: #F04438;
  --danger-red-soft: #FEECEB;

  /* 中性色 */
  --text-main: #1D2939;
  --text-sub: #475467;
  --text-weak: #98A2B3;
  --border-color: #EAECF0;
  --bg-page: #F5F7FB;
  --bg-card: #FFFFFF;
  --bg-gray: #F2F4F7;

  /* 尺寸与阴影 */
  --radius-sm: 8rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;
  --shadow-card: 0 4rpx 20rpx rgba(16, 24, 40, 0.06);

  background-color: var(--bg-page);
  color: var(--text-main);
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Helvetica, sans-serif;
  line-height: 1.55;
}

/* ---------- 布局 ---------- */
.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 24rpx 48rpx;
}

.page-with-footer {
  padding-bottom: 220rpx;
}

.row {
  display: flex;
  align-items: center;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.col {
  display: flex;
  flex-direction: column;
}

.flex-1 {
  flex: 1;
  min-width: 0;
}

.gap-8 {
  gap: 8rpx;
}

.gap-16 {
  gap: 16rpx;
}

.gap-24 {
  gap: 24rpx;
}

.mt-8 { margin-top: 8rpx; }
.mt-16 { margin-top: 16rpx; }
.mt-24 { margin-top: 24rpx; }
.mt-32 { margin-top: 32rpx; }
.mb-16 { margin-bottom: 16rpx; }
.mb-24 { margin-bottom: 24rpx; }

/* ---------- 卡片 ---------- */
.card {
  background-color: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 28rpx;
  box-shadow: var(--shadow-card);
  margin-bottom: 24rpx;
}

.card-flat {
  background-color: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 28rpx;
  border: 2rpx solid var(--border-color);
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-main);
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
}

.section-title::before {
  content: "";
  width: 8rpx;
  height: 30rpx;
  border-radius: 4rpx;
  background: linear-gradient(180deg, var(--brand-primary-light), var(--brand-primary));
  margin-right: 14rpx;
}

.section-title-plain {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 16rpx;
}

/* ---------- 文本 ---------- */
.title-lg {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-main);
}

.title-md {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-main);
}

.text-sub {
  color: var(--text-sub);
  font-size: 26rpx;
}

.text-weak {
  color: var(--text-weak);
  font-size: 24rpx;
}

.text-green {
  color: var(--trust-green);
}

.text-blue {
  color: var(--brand-primary);
}

.text-orange {
  color: var(--warn-orange);
}

.text-red {
  color: var(--danger-red);
}

.text-bold {
  font-weight: 600;
}

.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.ellipsis-2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.divider {
  height: 2rpx;
  background-color: var(--border-color);
  margin: 20rpx 0;
}

/* ---------- 标签 ---------- */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 1.6;
  background-color: var(--bg-gray);
  color: var(--text-sub);
  margin-right: 12rpx;
  margin-bottom: 8rpx;
}

.tag-blue {
  background-color: var(--brand-primary-soft);
  color: var(--brand-primary);
}

.tag-green {
  background-color: var(--trust-green-soft);
  color: var(--trust-green);
}

.tag-orange {
  background-color: var(--warn-orange-soft);
  color: var(--warn-orange);
}

.tag-red {
  background-color: var(--danger-red-soft);
  color: var(--danger-red);
}

.tag-line {
  background-color: transparent;
  border: 2rpx solid var(--border-color);
}

/* ---------- 按钮 ---------- */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
  box-sizing: border-box;
}

.btn::after {
  border: none;
}

.btn-primary {
  background: linear-gradient(135deg, var(--brand-primary-light), var(--brand-primary));
  color: #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(31, 79, 191, 0.24);
}

.btn-green {
  background: linear-gradient(135deg, #22C77A, var(--trust-green));
  color: #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(23, 178, 106, 0.22);
}

.btn-ghost {
  background-color: #ffffff;
  color: var(--brand-primary);
  border: 2rpx solid var(--brand-primary);
}

.btn-gray {
  background-color: var(--bg-gray);
  color: var(--text-sub);
}

.btn-disabled {
  background-color: #D0D5DD !important;
  color: #ffffff !important;
  box-shadow: none !important;
  border: none !important;
}

.btn-sm {
  height: 64rpx;
  font-size: 26rpx;
  padding: 0 32rpx;
  border-radius: 999rpx;
}

/* ---------- 表单 ---------- */
.form-item {
  background-color: var(--bg-card);
  border-radius: var(--radius-md);
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
}

.form-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
  margin-bottom: 12rpx;
  display: flex;
  align-items: center;
}

.form-label-required::after {
  content: "*";
  color: var(--danger-red);
  margin-left: 6rpx;
}

.form-input {
  width: 100%;
  font-size: 28rpx;
  color: var(--text-main);
  min-height: 60rpx;
}

.form-textarea {
  width: 100%;
  min-height: 160rpx;
  font-size: 28rpx;
  color: var(--text-main);
}

.form-tip {
  font-size: 22rpx;
  color: var(--text-weak);
  margin-top: 8rpx;
}

.placeholder {
  color: var(--text-weak);
}

/* ---------- 选择器组 ---------- */
.chip-group {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.chip {
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  background-color: var(--bg-gray);
  color: var(--text-sub);
  font-size: 26rpx;
}

.chip-active {
  background-color: var(--brand-primary-soft);
  color: var(--brand-primary);
  font-weight: 600;
  border: 2rpx solid var(--brand-primary);
}

/* ---------- 底部操作条 ---------- */
.footer-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background-color: #ffffff;
  border-top: 2rpx solid var(--border-color);
  display: flex;
  gap: 20rpx;
  z-index: 20;
}

/* ---------- 免责声明 ---------- */
.disclaimer {
  font-size: 22rpx;
  color: var(--text-weak);
  line-height: 1.7;
  background-color: var(--bg-gray);
  border-radius: var(--radius-md);
  padding: 20rpx 24rpx;
}

.disclaimer-title {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-sub);
  margin-bottom: 8rpx;
}

/* ---------- 空状态 / 加载 ---------- */
.empty {
  padding: 120rpx 40rpx;
  text-align: center;
}

.empty-icon {
  font-size: 96rpx;
  line-height: 1;
}

.empty-text {
  margin-top: 20rpx;
  color: var(--text-weak);
  font-size: 26rpx;
}

.loading {
  padding: 80rpx 0;
  text-align: center;
  color: var(--text-weak);
  font-size: 26rpx;
}

/* ---------- 通用小横条 ---------- */
.trust-bar {
  display: flex;
  align-items: center;
  justify-content: space-around;
  background-color: #ffffff;
  border-radius: var(--radius-lg);
  padding: 20rpx 12rpx;
  box-shadow: var(--shadow-card);
}

.trust-item {
  flex: 1;
  text-align: center;
}

.trust-item-icon {
  font-size: 36rpx;
}

.trust-item-text {
  font-size: 22rpx;
  color: var(--text-sub);
  margin-top: 6rpx;
}
